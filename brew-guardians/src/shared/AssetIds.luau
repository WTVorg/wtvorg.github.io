-- Asset ids for uploaded art, sounds and icons. This file is regenerated by
-- the publish pipeline (tools/publish) after it uploads everything to Roblox.
-- Empty values mean "not uploaded"; the game then falls back to imported art,
-- engine sounds and drawn icons.

return {
	ArtPack = nil :: number?, -- Model asset made from art/BrewGuardiansArt.fbx
	Sounds = {} :: { [string]: number }, -- slot ("Throw", "Music", ...) -> audio asset id
	Icons = {} :: { [string]: number }, -- icon key ("Guardian_Mossling", ...) -> decal asset id
}
