  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Brew Guardians server entry point.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

require(ReplicatedStorage.Shared.Remotes) -- create the RemoteEvents first

local Actions = require(script.Actions)
local GuardianService = require(script.GuardianService)
local Harvest = require(script.Harvest)
local PlayerData = require(script.PlayerData)
local Plots = require(script.Plots)
local WorldBuilder = require(script.WorldBuilder)

-- Each step runs on its own so one failure can't take the whole game down.
-- Any error still shows in the Output window with its stack trace.
local function start(name: string, fn: () -> ())
	local ok, err = xpcall(fn, debug.traceback)
	if not ok then
		warn(string.format("[BrewGuardians] %s failed to start:\n%s", name, tostring(err)))
	end
end

start("World", WorldBuilder.Build)
start("Plots", Plots.Start)
start("PlayerData", PlayerData.Start)
start("Harvest", Harvest.Start)
start("Guardians", GuardianService.Start)
start("Actions", Actions.Start)

print("[BrewGuardians] server ready")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Actions</string>
          <string name="Source"><![CDATA[-- Handles every request from the client. The client only asks; all checks,
-- rolls and inventory changes happen here.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GuardianService = require(script.Parent.GuardianService)
local PlayerData = require(script.Parent.PlayerData)
local Plots = require(script.Parent.Plots)
local WorldBuilder = require(script.Parent.WorldBuilder)

local POT_RANGE = 16

local Actions = {}

local rng = Random.new()
local lastThrow: { [Player]: number } = {}

local function notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function luckFor(data): number
	if data.LuckUntil and data.LuckUntil > os.time() then
		return Config.Monetization.LuckBoostMultiplier
	end
	return 1
end

local function journalEntry(data, guardianId: string)
	local entry = data.Journal[guardianId]
	if not entry then
		entry = { Seen = true, Caught = 0, FavoriteKnown = false, Tried = {} }
		data.Journal[guardianId] = entry
	end
	return entry
end

-- Validates a list of ingredient ids from the client and returns the counts
-- needed, or nil if the player does not own them.
local function ingredientCost(data, list: any, expected: number): { [string]: number }?
	if type(list) ~= "table" or #list ~= expected then
		return nil
	end
	local need = {}
	for i = 1, expected do
		local id = list[i]
		if type(id) ~= "string" or not Config.Ingredients[id] then
			return nil
		end
		need[id] = (need[id] or 0) + 1
	end
	for id, count in need do
		if (data.Ingredients[id] or 0) < count then
			return nil
		end
	end
	return need
end

local function spend(data, need: { [string]: number })
	for id, count in need do
		data.Ingredients[id] -= count
	end
end

local function findGuardianEntry(data, uid: any)
	if type(uid) ~= "string" then
		return nil, nil
	end
	for i, entry in data.Guardians do
		if entry.Uid == uid then
			return entry, i
		end
	end
	return nil, nil
end

----------------------------------------------------------------------
-- Throwing
----------------------------------------------------------------------
local function resolveFlask(player: Player, g, flask)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	local chance = GuardianService.Chance(g, flask.Mult, luckFor(data))
	local shakes = CatchMath.Roll(chance, rng)
	local caught = shakes >= CatchMath.Shakes

	GuardianService.BeginCapture(g)
	Remotes.CaptureSequence:FireAllClients({
		Position = GuardianService.GroundPosition(g),
		Shakes = shakes,
		FlaskId = flask.Id,
		Color = flask.Color,
		GuardianId = g.Id,
		ThrowerUserId = player.UserId,
		Chance = chance,
	})

	task.wait(CatchMath.Duration(shakes))

	if caught and not player.Parent then
		caught = false -- thrower left mid-shake, let it go
	end
	GuardianService.EndCapture(g, caught)

	local pct = math.floor(chance * 100 + 0.5)
	if caught then
		local entry = { Uid = PlayerData.NewUid(), Id = g.Id, Mutation = 0, CaughtAt = os.time() }
		PlayerData.Update(player, function(d)
			table.insert(d.Guardians, entry)
			local j = journalEntry(d, g.Id)
			j.Caught += 1
			d.Stats.Catches += 1
			return true
		end)
		Plots.Refresh(player)
		notify(player, string.format("Gotcha! %s was caught! (%d%% chance)", g.Def.Name, pct), "catch")
		local rarity = Config.Rarities[g.Def.Rarity]
		if rarity.Order >= 3 then
			Remotes.Announce:FireAllClients(string.format("%s caught a %s %s!", player.DisplayName, g.Def.Rarity, g.Def.Name))
		end
	else
		if shakes == CatchMath.Shakes - 1 then
			PlayerData.Update(player, function(d)
				d.Stats.NearMisses += 1
				return true
			end)
			notify(player, string.format("Argh! It broke out on the last shake! (%d%% chance)", pct), "nearmiss")
		else
			notify(player, string.format("%s burst free and it's furious! (%d%% chance)", g.Def.Name, pct), "fail")
		end
	end
end

local function onThrow(player: Player, kind: any, tierId: any, model: any)
	if kind ~= "Flask" and kind ~= "Draught" then
		return
	end
	if type(tierId) ~= "string" then
		return
	end
	local item = if kind == "Flask" then Config.GetFlask(tierId) else Config.GetDraught(tierId)
	if not item then
		return
	end
	local data = PlayerData.Get(player)
	local root = rootOf(player)
	local g = GuardianService.FromModel(model)
	if not data or not root or not g then
		return
	end
	local t = os.clock()
	if lastThrow[player] and t - lastThrow[player] < Config.Catch.ThrowCooldown then
		return
	end
	if (root.Position - GuardianService.GroundPosition(g)).Magnitude > Config.Catch.ThrowRange then
		notify(player, "Too far away to throw.", "error")
		return
	end
	local bag = if kind == "Flask" then data.Flasks else data.Draughts
	if (bag[tierId] or 0) <= 0 then
		notify(player, "You don't have any " .. item.Name .. "s. Brew some at your cauldron!", "error")
		return
	end
	lastThrow[player] = t

	PlayerData.Update(player, function(d)
		bag[tierId] -= 1
		d.Stats.Throws += 1
		journalEntry(d, g.Id).Seen = true
		return true
	end)

	Remotes.ThrowVisual:FireAllClients(root.Position, model, item.Color, Config.Catch.FlightTime)
	task.wait(Config.Catch.FlightTime)

	g = GuardianService.FromModel(model)
	if not g then
		-- Someone else's flask got there first.
		PlayerData.Update(player, function()
			bag[tierId] += 1
			return true
		end)
		notify(player, "Missed! Your " .. item.Name .. " bounced back to you.", "info")
		return
	end

	if kind == "Draught" then
		GuardianService.ApplyDraught(g, item.Power, player)
	else
		resolveFlask(player, g, item)
	end
end

----------------------------------------------------------------------
-- Feeding
----------------------------------------------------------------------
local function onFeed(player: Player, model: any, ingredientId: any)
	if type(ingredientId) ~= "string" or not Config.Ingredients[ingredientId] then
		return
	end
	local data = PlayerData.Get(player)
	local root = rootOf(player)
	local g = GuardianService.FromModel(model)
	if not data or not root or not g then
		return
	end
	if (root.Position - GuardianService.GroundPosition(g)).Magnitude > Config.Catch.FeedRange + g.Def.Size then
		notify(player, "Get closer to feed it.", "error")
		return
	end
	if (data.Ingredients[ingredientId] or 0) <= 0 then
		notify(player, "You're out of " .. Config.Ingredients[ingredientId].Name .. ".", "error")
		return
	end
	if g.FedFavorite then
		notify(player, g.Def.Name .. " is already happily munching.", "info")
		return
	end

	local isFavorite = g.Def.Favorite == ingredientId
	PlayerData.Update(player, function(d)
		d.Ingredients[ingredientId] -= 1
		local j = journalEntry(d, g.Id)
		j.Tried[ingredientId] = true
		if isFavorite then
			j.FavoriteKnown = true
		end
		return true
	end)
	GuardianService.Feed(g, isFavorite)

	local ingredientName = Config.Ingredients[ingredientId].Name
	if isFavorite then
		GuardianService.Celebrate(g, Color3.fromRGB(255, 120, 200))
		notify(
			player,
			string.format("%s loves the %s! It calms down. Catch odds x%d!", g.Def.Name, ingredientName, Config.Catch.FavoriteMult),
			"favorite"
		)
	else
		notify(player, string.format("%s sniffs the %s and turns away.", g.Def.Name, ingredientName), "info")
	end
end

----------------------------------------------------------------------
-- Brewing and fusing
----------------------------------------------------------------------
local function onBrew(player: Player, mode: any, list: any)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	if mode ~= "Flask" and mode ~= "Draught" then
		return
	end
	local brew = Plots.NearbyBrew(player, POT_RANGE)
	if not brew then
		notify(player, "Stand next to a cauldron to brew.", "error")
		return
	end
	local count = if mode == "Flask" then Config.FlaskIngredientCount else Config.DraughtIngredientCount
	local need = ingredientCost(data, list, count)
	if not need then
		notify(player, "You don't have those ingredients.", "error")
		return
	end
	if data.Vials <= 0 then
		notify(player, "You need an Empty Vial. Buy them at the shop in the hub.", "error")
		return
	end

	local quality = Config.QualityOf(list, data.PotLevel)
	local result = if mode == "Flask" then Config.FlaskForQuality(quality) else Config.DraughtForQuality(quality)
	PlayerData.Update(player, function(d)
		spend(d, need)
		d.Vials -= 1
		local bag = if mode == "Flask" then d.Flasks else d.Draughts
		bag[result.Id] = (bag[result.Id] or 0) + 1
		d.Stats.Brews += 1
		return true
	end)
	Plots.BrewEffect(brew, result.Color)
	notify(player, string.format("Brewed a %s! (quality %d)", result.Name, quality), "brew")
end

local function onFuse(player: Player, uid: any, list: any)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	local brew = Plots.NearbyBrew(player, POT_RANGE)
	if not brew then
		notify(player, "Stand next to a cauldron to fuse.", "error")
		return
	end
	local entry = findGuardianEntry(data, uid)
	if not entry then
		return
	end
	local nextLevel = (entry.Mutation or 0) + 1
	local mutation = Config.Mutations[nextLevel]
	if not mutation then
		notify(player, "This guardian can't grow any bigger.", "error")
		return
	end
	local need = ingredientCost(data, list, Config.FlaskIngredientCount)
	if not need then
		notify(player, "You don't have those ingredients.", "error")
		return
	end
	local quality = Config.QualityOf(list, data.PotLevel)
	if quality < mutation.MinQuality then
		notify(player, string.format("Needs brew quality %d to become %s (you have %d).", mutation.MinQuality, mutation.Prefix, quality), "error")
		return
	end
	PlayerData.Update(player, function(d)
		spend(d, need)
		entry.Mutation = nextLevel
		return true
	end)
	Plots.Refresh(player)
	Plots.BrewEffect(brew, Color3.fromRGB(255, 80, 200))
	notify(player, string.format("It grew into a %s!", Config.GuardianDisplayName(entry)), "catch")
end

----------------------------------------------------------------------
-- Shop and collection
----------------------------------------------------------------------
local function onBuy(player: Player, itemId: any)
	if type(itemId) ~= "string" then
		return
	end
	local item = Config.GetShopItem(itemId)
	local data = PlayerData.Get(player)
	if not item or not data then
		return
	end
	if item.PotLevel and data.PotLevel ~= item.PotLevel - 1 then
		notify(player, if data.PotLevel >= item.PotLevel then "You already own that." else "Buy the previous cauldron first.", "error")
		return
	end
	if data.Coins < item.Price then
		notify(player, "Not enough coins.", "error")
		return
	end
	PlayerData.Update(player, function(d)
		d.Coins -= item.Price
		if item.PotLevel then
			d.PotLevel = item.PotLevel
		else
			d.Vials += item.Amount
		end
		return true
	end)
	notify(player, "Bought " .. item.Name .. "!", "coins")
end

local function onRelease(player: Player, uid: any)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	local entry, index = findGuardianEntry(data, uid)
	if not entry or not index then
		return
	end
	local value = math.floor(Config.GuardianIncome(entry) * Config.ReleaseValueSeconds)
	PlayerData.Update(player, function(d)
		table.remove(d.Guardians, index)
		d.Coins += value
		return true
	end)
	Plots.Refresh(player)
	notify(player, string.format("Released %s. +%d coins", Config.GuardianDisplayName(entry), value), "coins")
end

----------------------------------------------------------------------
-- Robux luck boost (a boost, never a random item)
----------------------------------------------------------------------
local function onBuyLuck(player: Player)
	local id = Config.Monetization.LuckBoostProductId
	if id == 0 then
		notify(player, "Lucky Brew isn't on sale yet.", "info")
		return
	end
	MarketplaceService:PromptProductPurchase(player, id)
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and PlayerData.Get(player)
	if not player or not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if data.Purchases[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if receipt.ProductId ~= Config.Monetization.LuckBoostProductId then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	PlayerData.Update(player, function(d)
		local start = math.max(d.LuckUntil or 0, os.time())
		d.LuckUntil = start + Config.Monetization.LuckBoostMinutes * 60
		d.Purchases[receipt.PurchaseId] = true
		return true
	end)
	PlayerData.Save(player)
	notify(player, "Lucky Brew active! Catch odds boosted.", "favorite")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

----------------------------------------------------------------------
-- Journal: mark guardians as seen when you get close
----------------------------------------------------------------------
local function seenLoop()
	while true do
		task.wait(2)
		local wild = GuardianService.All()
		for _, player in Players:GetPlayers() do
			local data = PlayerData.Get(player)
			local root = rootOf(player)
			if data and root then
				local changed = false
				for _, g in wild do
					if not data.Journal[g.Id] and (root.Position - g.Position).Magnitude < 50 then
						journalEntry(data, g.Id)
						changed = true
						notify(player, "New guardian spotted: " .. g.Def.Name .. "! (added to your Journal)", "info")
					end
				end
				if changed then
					PlayerData.Push(player)
				end
			end
		end
	end
end

function Actions.Start()
	Remotes.Throw.OnServerEvent:Connect(onThrow)
	Remotes.Feed.OnServerEvent:Connect(onFeed)
	Remotes.Brew.OnServerEvent:Connect(onBrew)
	Remotes.Fuse.OnServerEvent:Connect(onFuse)
	Remotes.Buy.OnServerEvent:Connect(onBuy)
	Remotes.Release.OnServerEvent:Connect(onRelease)
	Remotes.BuyLuck.OnServerEvent:Connect(onBuyLuck)
	MarketplaceService.ProcessReceipt = processReceipt

	local publicPrompt = WorldBuilder.PublicBrewPrompt
	if publicPrompt then
		publicPrompt.Triggered:Connect(function(player)
			Remotes.OpenUI:FireClient(player, "Brew")
		end)
	end

	local shopPrompt = WorldBuilder.ShopPrompt
	if shopPrompt then
		shopPrompt.Triggered:Connect(function(player)
			Remotes.OpenUI:FireClient(player, "Shop")
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		lastThrow[player] = nil
	end)

	task.spawn(seenLoop)
end

return Actions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[-- Low-level part helpers shared by the world, plots and guardian builders.
-- Ellipsoids use a SpecialMesh sphere, which stretches to fill the part, so
-- bodies can be egg-shaped instead of perfect balls.

local Build = {}

local function apply(p: BasePart, color: Color3?, material: Enum.Material?, props: { [string]: any }?)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = material or Enum.Material.SmoothPlastic
	if color then
		p.Color = color
	end
	if props then
		for k, v in props do
			(p :: any)[k] = v
		end
	end
end

function Build.part(parent: Instance, cf: CFrame, size: Vector3, color: Color3?, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	apply(p, color, material, props)
	p.Parent = parent
	return p
end

function Build.ellipsoid(parent: Instance, cf: CFrame, size: Vector3, color: Color3?, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Build.part(parent, cf, size, color, material, props)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- Cylinder standing along cf's up vector.
function Build.cylinder(parent: Instance, cf: CFrame, height: number, diameter: number, color: Color3?, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
	apply(p, color, material, props)
	p.Parent = parent
	return p
end

function Build.wedge(parent: Instance, cf: CFrame, size: Vector3, color: Color3?, material: Enum.Material?, props: { [string]: any }?): WedgePart
	local p = Instance.new("WedgePart")
	p.Size = size
	p.CFrame = cf
	apply(p, color, material, props)
	p.Parent = parent
	return p
end

-- A tapered horn pointing along cf's up vector (two stacked ellipsoids).
function Build.spike(parent: Instance, cf: CFrame, height: number, width: number, color: Color3?, material: Enum.Material?, props: { [string]: any }?)
	Build.ellipsoid(parent, cf * CFrame.new(0, height * 0.32, 0), Vector3.new(width, height * 0.7, width), color, material, props)
	Build.ellipsoid(parent, cf * CFrame.new(0, height * 0.68, 0), Vector3.new(width * 0.5, height * 0.62, width * 0.5), color, material, props)
end

-- A roof-like ridge along cf's up vector (two wedges back to back), for crystal tips.
function Build.tent(parent: Instance, cf: CFrame, height: number, width: number, color: Color3?, material: Enum.Material?, props: { [string]: any }?)
	local half = width / 2
	Build.wedge(parent, cf * CFrame.new(0, height / 2, -half / 2), Vector3.new(width, height, half), color, material, props)
	Build.wedge(parent, cf * CFrame.new(0, height / 2, half / 2) * CFrame.Angles(0, math.pi, 0), Vector3.new(width, height, half), color, material, props)
end

-- Torus-like ring lying flat in cf's XZ plane.
function Build.ring(parent: Instance, cf: CFrame, radius: number, thickness: number, segments: number, color: Color3?, material: Enum.Material?, props: { [string]: any }?)
	local seg = 2 * math.pi * radius / segments * 1.08
	for i = 1, segments do
		local a = (i / segments) * math.pi * 2
		local at = cf * CFrame.Angles(0, a, 0) * CFrame.new(radius, 0, 0)
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(seg, thickness, thickness)
		-- cylinder axis is X; turn it to run tangent to the ring
		p.CFrame = at * CFrame.Angles(0, math.rad(90), 0)
		apply(p, color, material, props)
		p.Parent = parent
	end
end

-- Moves a model up or down so its lowest point sits at groundY.
function Build.sitOnGround(model: Model, groundY: number)
	local cf, size = model:GetBoundingBox()
	local bottom = cf.Position.Y - size.Y / 2
	model:PivotTo(model:GetPivot() + Vector3.new(0, groundY - bottom, 0))
end

function Build.model(name: string, parent: Instance?): Model
	local m = Instance.new("Model")
	m.Name = name
	if parent then
		m.Parent = parent
	end
	return m
end

function Build.light(parent: Instance, color: Color3, range: number, brightness: number?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1
	l.Shadows = false
	l.Parent = parent
	return l
end

function Build.sparkles(parent: Instance, color: Color3, rate: number, size: number?)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(color)
	e.LightEmission = 1
	e.Size = NumberSequence.new(size or 0.4, 0)
	e.Lifetime = NumberRange.new(0.8, 1.6)
	e.Rate = rate
	e.Speed = NumberRange.new(0.5, 2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Parent = parent
	return e
end

-- Big readable text on a part face.
function Build.surfaceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3, font: Enum.Font?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = font or Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.6
	label.Text = text
	label.Parent = gui
	return label
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">GuardianModels</string>
          <string name="Source"><![CDATA[-- Builds a guardian body. Uses ServerStorage.GuardianModels[id] when it
-- exists, otherwise a hand-built creature made of parts.
--
-- Builders work in "body units": 1 unit = the guardian's Size in studs.
-- The root sits at the body centre, the ground is at y = -0.5, front is -Z.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Build = require(script.Parent.Build)

local GuardianModels = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromRGB(20, 18, 26)
local BLUSH = Color3.fromRGB(255, 140, 170)

type Kit = {
	s: number,
	P: (x: number, y: number, z: number) -> CFrame,
	e: (cf: CFrame, x: number, y: number, z: number, color: Color3, material: Enum.Material?, name: string?) -> Part,
	cyl: (cf: CFrame, height: number, diameter: number, color: Color3, material: Enum.Material?) -> Part,
	spike: (cf: CFrame, height: number, width: number, color: Color3, material: Enum.Material?) -> (),
	eyes: (y: number, z: number, spread: number, size: number, iris: Color3?) -> (),
	legs: (positions: { Vector3 }, length: number, thickness: number, color: Color3, paw: Color3?) -> (),
}

local function newKit(model: Model, root: BasePart, s: number): Kit
	local kit = {} :: any
	kit.s = s
	function kit.P(x, y, z)
		return CFrame.new(x * s, y * s, z * s)
	end
	function kit.e(cf, x, y, z, color, material, name)
		local p = Build.ellipsoid(model, root.CFrame * cf, Vector3.new(x, y, z) * s, color, material)
		p.Name = name or "Body"
		return p
	end
	function kit.cyl(cf, height, diameter, color, material)
		local p = Build.cylinder(model, root.CFrame * cf, height * s, diameter * s, color, material)
		p.Name = "Body"
		return p
	end
	function kit.spike(cf, height, width, color, material)
		Build.spike(model, root.CFrame * cf, height * s, width * s, color, material)
	end
	-- Big cartoon eyes: white, dark pupil, sparkle.
	function kit.eyes(y, z, spread, size, iris)
		for _, side in { -1, 1 } do
			local base = kit.P(side * spread, y, z)
			kit.e(base, size, size * 1.15, size * 0.55, WHITE, nil, "Eye")
			kit.e(base * kit.P(0, -size * 0.08, -size * 0.2), size * 0.62, size * 0.78, size * 0.3, iris or BLACK, nil, "Pupil")
			kit.e(base * kit.P(side * size * 0.12, size * 0.18, -size * 0.32), size * 0.24, size * 0.24, size * 0.1, WHITE, Enum.Material.Neon, "Sparkle")
		end
	end
	-- Legs from a hip position straight down to the ground, with paws.
	function kit.legs(positions, length, thickness, color, paw)
		for _, hip in positions do
			kit.cyl(kit.P(hip.X, hip.Y - length / 2, hip.Z), length, thickness, color)
			kit.e(kit.P(hip.X, -0.5 + thickness * 0.3, hip.Z - thickness * 0.15), thickness * 1.25, thickness * 0.6, thickness * 1.5, paw or color)
		end
	end
	return kit :: Kit
end

----------------------------------------------------------------------
-- Species
----------------------------------------------------------------------
local Species = {}

function Species.Mossling(k: Kit, def)
	local green, sun = def.Color, def.Accent
	k.e(k.P(0, -0.06, 0), 1, 0.86, 0.95, green)
	k.e(k.P(0, -0.12, -0.12), 0.72, 0.6, 0.72, green:Lerp(WHITE, 0.25)) -- lighter belly
	k.eyes(0.06, -0.4, 0.18, 0.24)
	for _, side in { -1, 1 } do
		k.e(k.P(side * 0.32, -0.1, -0.36), 0.16, 0.1, 0.06, BLUSH, nil, "Accent")
		k.e(k.P(side * 0.3, -0.42, -0.18), 0.28, 0.16, 0.36, green:Lerp(BLACK, 0.2)) -- feet
		k.e(k.P(side * 0.3, -0.42, 0.22), 0.26, 0.15, 0.3, green:Lerp(BLACK, 0.2))
		k.e(k.P(side * 0.48, -0.12, -0.05) * CFrame.Angles(0, 0, side * math.rad(-30)), 0.14, 0.3, 0.14, green) -- arms
	end
	k.e(k.P(0, -0.08, -0.47), 0.12, 0.05, 0.04, BLACK, nil, "Mouth")
	-- sprout
	k.cyl(k.P(0, 0.5, 0), 0.22, 0.06, Color3.fromRGB(70, 130, 50))
	for _, side in { -1, 1 } do
		k.e(k.P(side * 0.14, 0.6, 0) * CFrame.Angles(0, 0, side * math.rad(-35)), 0.32, 0.08, 0.16, Color3.fromRGB(110, 200, 80), Enum.Material.Grass)
	end
	k.e(k.P(0, 0.64, 0), 0.14, 0.14, 0.14, sun, Enum.Material.Neon, "Accent")
	-- moss tufts on the back
	for i = 1, 5 do
		local a = i / 5 * math.pi * 1.2 - 0.6
		k.e(k.P(math.sin(a) * 0.3, 0.3, 0.2 + math.cos(a) * 0.12), 0.26, 0.18, 0.26, green:Lerp(Color3.fromRGB(40, 90, 40), 0.5), Enum.Material.Grass)
	end
end

function Species.Thornback(k: Kit, def)
	local hide, thorn = def.Color, def.Accent
	k.e(k.P(0, -0.05, 0.05), 0.85, 0.6, 1.2, hide)
	for i = -1, 1 do
		k.e(k.P(0, 0.02, 0.05 + i * 0.32), 0.9, 0.55, 0.3, hide:Lerp(BLACK, 0.25)) -- armour bands
	end
	for row = -1, 1 do
		for i = 0, 3 do
			local z = -0.3 + i * 0.25
			k.spike(k.P(row * 0.25, 0.18 - math.abs(row) * 0.08, z) * CFrame.Angles(0, 0, row * math.rad(-30)), 0.32, 0.1, thorn, nil)
		end
	end
	-- head and snout
	k.e(k.P(0, -0.02, -0.6), 0.5, 0.42, 0.45, hide:Lerp(WHITE, 0.08))
	k.e(k.P(0, -0.1, -0.84), 0.28, 0.22, 0.2, Color3.fromRGB(150, 110, 90), nil, "Snout")
	for _, side in { -1, 1 } do
		k.e(k.P(side * 0.06, -0.08, -0.94), 0.05, 0.06, 0.03, BLACK)
		k.spike(k.P(side * 0.15, -0.16, -0.82) * CFrame.Angles(math.rad(-60), 0, side * math.rad(-20)), 0.16, 0.05, Color3.fromRGB(245, 240, 225), nil)
		k.e(k.P(side * 0.2, 0.18, -0.55) * CFrame.Angles(0, 0, side * math.rad(-30)), 0.08, 0.16, 0.06, hide:Lerp(BLACK, 0.2))
	end
	k.eyes(0.06, -0.78, 0.12, 0.12, Color3.fromRGB(60, 30, 20))
	k.legs({ Vector3.new(-0.28, -0.2, -0.35), Vector3.new(0.28, -0.2, -0.35), Vector3.new(-0.28, -0.2, 0.4), Vector3.new(0.28, -0.2, 0.4) }, 0.3, 0.16, hide:Lerp(BLACK, 0.3))
	k.e(k.P(0, 0, 0.66), 0.1, 0.1, 0.18, hide)
end

function Species.Cinderpup(k: Kit, def)
	local fur, flame = def.Color, def.Accent
	k.e(k.P(0, -0.12, 0.08), 0.55, 0.5, 0.85, fur)
	k.e(k.P(0, -0.15, -0.18), 0.42, 0.38, 0.35, fur:Lerp(WHITE, 0.5)) -- chest
	k.e(k.P(0, 0.2, -0.38), 0.62, 0.56, 0.55, fur)
	k.e(k.P(0, 0.08, -0.66), 0.32, 0.24, 0.28, fur:Lerp(WHITE, 0.55), nil, "Snout")
	k.e(k.P(0, 0.14, -0.8), 0.1, 0.08, 0.06, BLACK)
	k.eyes(0.28, -0.6, 0.15, 0.17)
	for _, side in { -1, 1 } do
		k.e(k.P(side * 0.3, 0.22, -0.3) * CFrame.Angles(0, 0, side * math.rad(25)), 0.14, 0.38, 0.22, fur:Lerp(BLACK, 0.25)) -- floppy ears
	end
	-- flame tuft and tail
	k.e(k.P(0, 0.52, -0.36), 0.22, 0.26, 0.22, flame, Enum.Material.Neon, "Accent")
	k.e(k.P(0, 0.62, -0.32), 0.12, 0.18, 0.12, Color3.fromRGB(255, 250, 200), Enum.Material.Neon, "Accent")
	local tail = { { 0.05, 0.5, 0.2 }, { 0.2, 0.62, 0.16 }, { 0.36, 0.7, 0.12 } }
	for i, t in tail do
		k.e(k.P(0, -0.05 + t[1], 0.5 + i * 0.08), t[3] * 2, t[3] * 2.4, t[3] * 2, if i == 3 then Color3.fromRGB(255, 250, 200) else flame, Enum.Material.Neon, "Accent")
	end
	k.legs({ Vector3.new(-0.16, -0.25, -0.14), Vector3.new(0.16, -0.25, -0.14), Vector3.new(-0.16, -0.25, 0.3), Vector3.new(0.16, -0.25, 0.3) }, 0.25, 0.13, fur, fur:Lerp(WHITE, 0.5))
end

function Species.Magmaw(k: Kit, def)
	local rock, lava = def.Color, def.Accent
	k.e(k.P(0, -0.08, 0.1), 1, 0.66, 1.15, rock)
	-- lava cracks along the back
	for i = 0, 4 do
		k.e(k.P(math.sin(i) * 0.15, 0.24, -0.25 + i * 0.16) * CFrame.Angles(0, i * 0.7, 0), 0.4, 0.04, 0.06, lava, Enum.Material.Neon, "Accent")
	end
	for _, side in { -1, 1 } do
		k.e(k.P(side * 0.35, 0.05, 0.1), 0.06, 0.04, 0.5, lava, Enum.Material.Neon, "Accent")
	end
	-- head with a huge jaw
	k.e(k.P(0, 0.02, -0.5), 0.78, 0.36, 0.5, rock:Lerp(WHITE, 0.05))
	k.e(k.P(0, -0.17, -0.5), 0.74, 0.12, 0.46, lava, Enum.Material.Neon, "Accent") -- glowing mouth
	k.e(k.P(0, -0.27, -0.48), 0.76, 0.16, 0.48, rock:Lerp(BLACK, 0.2))
	for _, side in { -1, 1 } do
		k.spike(k.P(side * 0.26, 0.15, -0.5) * CFrame.Angles(math.rad(25), 0, side * math.rad(-25)), 0.3, 0.1, rock:Lerp(BLACK, 0.4), Enum.Material.Basalt)
		for i = 0, 2 do
			k.spike(k.P(side * (0.12 + i * 0.1), -0.2, -0.72 + i * 0.03) * CFrame.Angles(math.rad(180), 0, 0), 0.07, 0.04, WHITE, nil)
		end
	end
	k.eyes(0.16, -0.68, 0.2, 0.1, lava)
	k.legs({ Vector3.new(-0.4, -0.22, -0.25), Vector3.new(0.4, -0.22, -0.25), Vector3.new(-0.4, -0.22, 0.42), Vector3.new(0.4, -0.22, 0.42) }, 0.28, 0.22, rock:Lerp(BLACK, 0.2))
	k.e(k.P(0, -0.15, 0.72), 0.3, 0.22, 0.45, rock)
	k.e(k.P(0, -0.25, 1.0), 0.16, 0.12, 0.34, rock)
	k.e(k.P(0, -0.3, 1.18), 0.08, 0.08, 0.14, lava, Enum.Material.Neon, "Accent")
end

function Species.Glimmerfox(k: Kit, def)
	local fur, gem = def.Color, def.Accent
	k.e(k.P(0, -0.02, 0.05), 0.42, 0.42, 0.85, fur)
	k.e(k.P(0, 0.05, -0.3), 0.36, 0.42, 0.3, WHITE) -- chest ruff
	k.e(k.P(0, 0.3, -0.45), 0.42, 0.4, 0.4, fur)
	k.e(k.P(0, 0.22, -0.7), 0.2, 0.16, 0.32, WHITE, nil, "Snout")
	k.e(k.P(0, 0.25, -0.86), 0.07, 0.06, 0.05, BLACK)
	k.eyes(0.36, -0.6, 0.12, 0.13, Color3.fromRGB(90, 50, 160))
	for _, side in { -1, 1 } do
		k.spike(k.P(side * 0.14, 0.44, -0.42) * CFrame.Angles(0, 0, side * math.rad(-12)), 0.32, 0.14, fur)
		k.spike(k.P(side * 0.15, 0.62, -0.42) * CFrame.Angles(0, 0, side * math.rad(-12)), 0.14, 0.07, gem, Enum.Material.Neon)
	end
	-- crystal mane
	for i = 0, 3 do
		k.spike(k.P(0, 0.18, -0.15 + i * 0.13) * CFrame.Angles(math.rad(15), 0, 0), 0.18 - i * 0.03, 0.08, gem, Enum.Material.Glass)
	end
	-- huge fluffy tail curling up
	k.e(k.P(0, 0.05, 0.55) * CFrame.Angles(math.rad(-30), 0, 0), 0.34, 0.34, 0.55, fur)
	k.e(k.P(0, 0.3, 0.78) * CFrame.Angles(math.rad(-60), 0, 0), 0.32, 0.32, 0.45, fur)
	k.e(k.P(0, 0.52, 0.82), 0.24, 0.24, 0.24, WHITE)
	k.e(k.P(0, 0.64, 0.82), 0.14, 0.2, 0.14, gem, Enum.Material.Neon, "Accent")
	k.legs({ Vector3.new(-0.12, -0.15, -0.22), Vector3.new(0.12, -0.15, -0.22), Vector3.new(-0.12, -0.15, 0.3), Vector3.new(0.12, -0.15, 0.3) }, 0.35, 0.09, fur, WHITE)
end

function Species.Aurorath(k: Kit, def)
	local body, glow = def.Color, def.Accent
	local deep = body:Lerp(Color3.fromRGB(20, 40, 70), 0.55)
	k.e(k.P(0, 0.05, 0.05), 0.44, 0.4, 0.8, deep)
	k.e(k.P(0, 0.08, -0.17), 0.38, 0.34, 0.34, body:Lerp(WHITE, 0.4))
	k.e(k.P(0, 0.28, -0.32) * CFrame.Angles(math.rad(-40), 0, 0), 0.16, 0.36, 0.16, deep) -- neck
	k.e(k.P(0, 0.44, -0.44), 0.2, 0.18, 0.28, deep)
	k.e(k.P(0, 0.4, -0.58), 0.12, 0.1, 0.16, body:Lerp(WHITE, 0.3), nil, "Snout")
	k.eyes(0.47, -0.52, 0.07, 0.07, glow)
	-- crystal antlers
	for _, side in { -1, 1 } do
		local base = k.P(side * 0.06, 0.54, -0.42)
		k.cyl(base * CFrame.Angles(0, 0, side * math.rad(-25)) * k.P(0, 0.12, 0), 0.24, 0.025, glow, Enum.Material.Neon)
		k.cyl(base * k.P(side * 0.1, 0.22, 0) * CFrame.Angles(0, 0, side * math.rad(-60)) * k.P(0, 0.06, 0), 0.12, 0.02, glow, Enum.Material.Neon)
		k.cyl(base * k.P(side * 0.06, 0.16, 0.04) * CFrame.Angles(math.rad(40), 0, side * math.rad(10)) * k.P(0, 0.06, 0), 0.12, 0.02, body, Enum.Material.Neon)
		k.e(base * k.P(side * 0.12, 0.26, 0), 0.04, 0.04, 0.04, WHITE, Enum.Material.Neon, "Accent")
	end
	-- flowing aurora mane and tail
	for i = 0, 4 do
		local t = i / 4
		k.e(k.P(0, 0.42 - t * 0.2, -0.36 + t * 0.4), 0.05, 0.16, 0.12, if i % 2 == 0 then glow else body, Enum.Material.Neon, "Accent")
	end
	for i = 0, 3 do
		k.e(k.P(0, 0.1 - i * 0.06, 0.45 + i * 0.12) * CFrame.Angles(math.rad(-20 - i * 10), 0, 0), 0.06, 0.08, 0.16, if i % 2 == 0 then body else glow, Enum.Material.Neon, "Accent")
	end
	k.legs({ Vector3.new(-0.12, -0.08, -0.15), Vector3.new(0.12, -0.08, -0.15), Vector3.new(-0.12, -0.08, 0.28), Vector3.new(0.12, -0.08, 0.28) }, 0.42, 0.08, deep, glow)
	for _, z in { -0.15, 0.28 } do
		for _, side in { -1, 1 } do
			k.e(k.P(side * 0.12, -0.1, z), 0.12, 0.18, 0.14, deep) -- thighs blend legs into the body
		end
	end
	-- spirit orbs drifting around it
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2
		k.e(k.P(math.cos(a) * 0.45, 0.3 + i * 0.06, math.sin(a) * 0.45), 0.06, 0.06, 0.06, if i == 2 then glow else body, Enum.Material.Neon, "Accent")
	end
end

----------------------------------------------------------------------
local function buildBuiltIn(id: string): Model
	local def = Config.Guardians[id]
	local s = def.Size
	local model = Instance.new("Model")

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(s * 0.8, s * 0.8, s * 0.8)
	root.Transparency = 1
	root.CanCollide = false
	root.Anchored = true
	root.CFrame = CFrame.new(0, s / 2, 0)
	root.Parent = model
	model.PrimaryPart = root

	local kit = newKit(model, root, s)
	local builder = Species[id]
	if builder then
		builder(kit, def)
	else
		-- Generic fallback for guardians added in Config without a builder.
		kit.e(kit.P(0, -0.05, 0), 0.9, 0.8, 0.9, def.Color)
		kit.eyes(0.1, -0.4, 0.17, 0.2)
		kit.e(kit.P(0, 0.45, 0), 0.25, 0.25, 0.25, def.Accent, Enum.Material.Neon, "Accent")
	end

	local light = Instance.new("PointLight")
	light.Color = def.Accent
	light.Range = s * 2
	light.Brightness = if def.Rarity == "Legendary" then 2.5 else 0.8
	light.Parent = root

	if def.Rarity == "Legendary" or def.Rarity == "Rare" then
		local aura = Build.sparkles(root, def.Accent, if def.Rarity == "Legendary" then 18 else 6, s * 0.08)
		aura.Name = "Aura"
	end

	-- One rigid body: everything welded to the anchored root, so moving the
	-- root moves the creature and only one part needs replicating.
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			d.Anchored = false
			d.CanCollide = false
			d.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = d
		end
	end
	return model
end

-- Returns a model whose PrimaryPart sits at the body centre.
function GuardianModels.Build(id: string, mutation: number?): Model
	local custom = ServerStorage:FindFirstChild("GuardianModels")
	local template = custom and custom:FindFirstChild(id)
	local model: Model
	if template and template:IsA("Model") and template.PrimaryPart then
		model = template:Clone()
		-- Everything anchored: the server moves the whole model with PivotTo.
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
			end
		end
	else
		model = buildBuiltIn(id)
	end
	model.Name = id
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic

	local m = Config.Mutations[mutation or 0]
	if m then
		model:ScaleTo(m.Scale)
		-- Mutated forms get a shifted, glowing accent colour.
		local tint = ({ Color3.fromRGB(255, 120, 220), Color3.fromRGB(150, 90, 255), Color3.fromRGB(255, 60, 90) })[mutation :: number]
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "Accent" then
				d.Color = tint
				d.Material = Enum.Material.Neon
			end
		end
		if model.PrimaryPart then
			local aura = Build.sparkles(model.PrimaryPart, tint, 4 + (mutation :: number) * 4, 0.6)
			aura.Name = "MutationAura"
		end
	end
	return model
end

-- Moves the model up or down so its lowest point sits at groundY.
function GuardianModels.SitOnGround(model: Model, groundY: number)
	Build.sitOnGround(model, groundY)
end

return GuardianModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">GuardianService</string>
          <string name="Source"><![CDATA[-- Wild guardians: spawning, chase AI, attacks, hazards and resistance.
-- Guardians are anchored models moved by the server every frame.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")

local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GuardianModels = require(script.Parent.GuardianModels)
local WorldBuilder = require(script.Parent.WorldBuilder)

local AGGRO_RANGE = 45
local DASH_SPEED = 75
local DODGE_CREDIT_RANGE = 16
local TELEGRAPH_COLOR = Color3.fromRGB(255, 50, 50)

local GuardianService = {}

local rng = Random.new()
local guardians: { [Model]: any } = {}
local folder: Folder
local effects: Folder
local hiddenFolder: Folder
local lastNotify: { [Player]: number } = {}

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function notifyThrottled(player: Player, text: string, kind: string)
	local now = os.clock()
	if lastNotify[player] and now - lastNotify[player] < 0.6 then
		return
	end
	lastNotify[player] = now
	Remotes.Notify:FireClient(player, text, kind)
end

local function playersNear(position: Vector3, radius: number): { Player }
	local out = {}
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if root and (flat(root.Position) - flat(position)).Magnitude <= radius then
			table.insert(out, player)
		end
	end
	return out
end

local function damagePlayer(player: Player, amount: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:TakeDamage(amount)
	end
end

local function telegraphDisc(position: Vector3, radius: number, windup: number): Part
	local p = WorldBuilder.Disc("Telegraph", position + Vector3.new(0, 0.35, 0), radius * 0.25, 0.2, TELEGRAPH_COLOR, Enum.Material.Neon, effects)
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 0.45
	TweenService:Create(p, TweenInfo.new(windup, Enum.EasingStyle.Linear), {
		Size = Vector3.new(0.2, radius * 2, radius * 2),
	}):Play()
	return p
end

local function shockwave(position: Vector3, radius: number, color: Color3)
	local p = WorldBuilder.Disc("Shockwave", position + Vector3.new(0, 0.5, 0), radius * 0.5, 0.6, color, Enum.Material.Neon, effects)
	p.CanCollide = false
	p.CanQuery = false
	local tween = TweenService:Create(p, TweenInfo.new(0.35), {
		Size = Vector3.new(0.6, radius * 2.3, radius * 2.3),
		Transparency = 1,
	})
	tween:Play()
	tween.Completed:Once(function()
		p:Destroy()
	end)
end

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local function now()
	return os.clock()
end

local function isStunned(g)
	return now() < g.StunUntil
end
local function isSlowed(g)
	return now() < g.SlowUntil
end
local function isEnraged(g)
	return now() < g.EnragedUntil
end
local function isCalm(g)
	return now() < g.CalmUntil
end

local function syncAttributes(g)
	local model = g.Model
	local function set(name, value)
		if model:GetAttribute(name) ~= value then
			model:SetAttribute(name, value)
		end
	end
	set("Resistance", math.floor(g.Resistance + 0.5))
	set("FedFavorite", g.FedFavorite)
	set("Stunned", isStunned(g))
	set("Slowed", isSlowed(g))
	set("Enraged", isEnraged(g))
	set("Calm", isCalm(g))
end

local function canAct(g)
	return g.Alive and not g.Capturing
end

function GuardianService.Weaken(g, amount: number, player: Player?, reason: string?)
	if not canAct(g) then
		return
	end
	local before = g.Resistance
	g.Resistance = math.max(0, g.Resistance - amount)
	if player and reason and before > g.Resistance then
		notifyThrottled(
			player,
			string.format("%s! %s resistance -%d", reason, g.Def.Name, math.floor(before - g.Resistance + 0.5)),
			"weaken"
		)
	end
end

local function creditDodge(g, candidates: { Player })
	for _, player in candidates do
		GuardianService.Weaken(g, g.Def.DodgeDrop, player, "Dodged")
	end
end

----------------------------------------------------------------------
-- Attacks (each runs in its own thread and sets g.Busy)
----------------------------------------------------------------------
local function waitWindup(g, seconds: number): boolean
	local t = 0
	while t < seconds do
		t += task.wait()
		if not canAct(g) or isStunned(g) then
			return false
		end
	end
	return true
end

local function cooldown(g)
	local mult = if isEnraged(g) then 0.6 else 1
	g.NextAttack = now() + g.Def.Attack.Cooldown * mult * rng:NextNumber(0.85, 1.2)
end

local function slam(g)
	local atk = g.Def.Attack
	local center = g.Position
	local tele = telegraphDisc(center, atk.Radius, atk.Windup)
	local ok = waitWindup(g, atk.Windup)
	tele:Destroy()
	if ok then
		shockwave(center, atk.Radius, g.Def.Accent)
		local hit = playersNear(center, atk.Radius)
		for _, player in hit do
			damagePlayer(player, atk.Damage)
		end
		if #hit == 0 then
			creditDodge(g, playersNear(center, atk.Radius + DODGE_CREDIT_RANGE))
		end
	end
	cooldown(g)
end

local function charge(g, target: Player)
	local atk = g.Def.Attack
	local targetRoot = rootOf(target)
	if not targetRoot then
		return
	end
	local dir = flat(targetRoot.Position - g.Position)
	if dir.Magnitude < 0.1 then
		dir = g.Facing
	end
	dir = dir.Unit
	g.Facing = dir

	local start = g.Position
	local mid = start + dir * (atk.Length / 2)
	local tele = WorldBuilder.Part({
		Name = "Telegraph",
		Size = Vector3.new(atk.Width, 0.2, atk.Length),
		CFrame = CFrame.lookAt(mid + Vector3.new(0, 0.35, 0), mid + dir + Vector3.new(0, 0.35, 0)),
		Color = TELEGRAPH_COLOR,
		Material = Enum.Material.Neon,
		Transparency = 0.5,
		CanCollide = false,
		CanQuery = false,
		Parent = effects,
	})
	local ok = waitWindup(g, atk.Windup)
	tele:Destroy()
	if not ok then
		cooldown(g)
		return
	end

	local travelled = 0
	local hitPlayers = {}
	g.Dashing = true
	while travelled < atk.Length and canAct(g) and not isStunned(g) do
		local dt = RunService.Heartbeat:Wait()
		local step = math.min(DASH_SPEED * dt, atk.Length - travelled)
		local nextPos = g.Position + dir * step
		local offset = nextPos - g.ZoneCenter
		if offset.Magnitude > g.ZoneRadius then
			break -- hit the edge of its territory
		end
		g.Position = nextPos
		travelled += step
		for _, player in playersNear(g.Position, atk.Width / 2 + g.Def.Size * 0.4) do
			if not hitPlayers[player] then
				hitPlayers[player] = true
				damagePlayer(player, atk.Damage)
			end
		end
	end
	g.Dashing = false

	if canAct(g) and not hitPlayers[target] then
		local root = rootOf(target)
		if root and (flat(root.Position) - start).Magnitude <= atk.Length + DODGE_CREDIT_RANGE then
			creditDodge(g, { target })
		end
	end
	cooldown(g)
end

local function orbs(g, target: Player)
	local atk = g.Def.Attack
	local targetRoot = rootOf(target)
	if not targetRoot then
		return
	end
	local spots = {}
	local base = flat(targetRoot.Position)
	for i = 1, atk.Orbs or 1 do
		local offset = if i == 1
			then Vector3.zero
			else Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit * atk.Radius * 1.6
		table.insert(spots, base + offset)
	end
	local teles = {}
	for _, spot in spots do
		table.insert(teles, telegraphDisc(spot, atk.Radius, atk.Windup))
	end
	local ok = waitWindup(g, atk.Windup)
	for _, t in teles do
		t:Destroy()
	end
	if ok then
		local targetHit = false
		for _, spot in spots do
			shockwave(spot, atk.Radius, g.Def.Accent)
			for _, player in playersNear(spot, atk.Radius) do
				damagePlayer(player, atk.Damage)
				if player == target then
					targetHit = true
				end
			end
		end
		if not targetHit and rootOf(target) then
			creditDodge(g, { target })
		end
	end
	cooldown(g)
end

local function startAttack(g, kind: string, target: Player)
	g.Busy = true
	task.spawn(function()
		local ok, err = pcall(function()
			if kind == "Slam" then
				slam(g)
			elseif kind == "Charge" then
				charge(g, target)
			else
				orbs(g, target)
			end
		end)
		if not ok then
			warn("[Guardian] attack error:", err)
		end
		g.Busy = false
		g.Dashing = false
	end)
end

----------------------------------------------------------------------
-- Movement and AI
----------------------------------------------------------------------
local function inHazard(zoneId: string, position: Vector3, pad: number)
	for _, hazard in WorldBuilder.Hazards do
		if hazard.Zone == zoneId and (flat(hazard.Position) - flat(position)).Magnitude < hazard.Radius + pad then
			return hazard
		end
	end
	return nil
end

local function pickWanderTarget(g): Vector3
	for _ = 1, 12 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * (g.ZoneRadius - 8)
		local p = g.ZoneCenter + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		if not inHazard(g.ZoneId, p, g.Def.Size + 3) then
			return p
		end
	end
	return g.ZoneCenter
end

local function nearestTarget(g): (Player?, number)
	local best, bestDist = nil, math.huge
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if root then
			local inZone = (flat(root.Position) - g.ZoneCenter).Magnitude <= g.ZoneRadius + 20
			local d = (flat(root.Position) - g.Position).Magnitude
			if inZone and d < bestDist then
				best, bestDist = player, d
			end
		end
	end
	if bestDist > AGGRO_RANGE then
		return nil, bestDist
	end
	return best, bestDist
end

local function move(g, direction: Vector3, speed: number, dt: number): boolean
	if direction.Magnitude < 0.01 then
		return false
	end
	direction = flat(direction).Unit
	g.Facing = g.Facing:Lerp(direction, math.min(dt * 8, 1))
	if g.Facing.Magnitude > 0.01 then
		g.Facing = g.Facing.Unit
	end
	local nextPos = g.Position + direction * speed * dt
	local offset = nextPos - g.ZoneCenter
	local cornered = false
	if offset.Magnitude > g.ZoneRadius then
		nextPos = g.ZoneCenter + offset.Unit * g.ZoneRadius
		cornered = true
	end
	g.Position = nextPos
	g.Moving = true
	return cornered
end

local function think(g, dt: number)
	local def = g.Def
	local t = now()
	g.Moving = false

	if g.Busy or isStunned(g) then
		return
	end

	local speed = def.Speed * (if isSlowed(g) then 0.5 else 1) * (if isEnraged(g) then 1.4 else 1)
	local target, dist = nearestTarget(g)

	if target and not isCalm(g) then
		g.LastPlayerNear = t
		local root = rootOf(target) :: BasePart
		local toTarget = flat(root.Position) - g.Position
		local ready = t >= g.NextAttack
		local behavior = def.Behavior
		local atk = def.Attack

		if behavior == "Skittish" then
			local cornered = false
			if dist < 26 then
				cornered = move(g, -toTarget, speed, dt)
			end
			if ready and (dist < atk.Radius * 0.85 or (cornered and dist < atk.Radius * 1.5)) then
				startAttack(g, "Slam", target)
			end
		elseif behavior == "Charger" then
			if dist > atk.Length * 0.6 then
				move(g, toTarget, speed, dt)
			elseif ready then
				startAttack(g, "Charge", target)
			end
		elseif behavior == "Caster" then
			if dist < 18 then
				move(g, -toTarget, speed, dt)
			elseif dist > 34 then
				move(g, toTarget, speed, dt)
			end
			if ready then
				startAttack(g, "Orbs", target)
			end
		else -- Legendary: rotates through every attack
			if dist > 28 then
				move(g, toTarget, speed, dt)
			end
			if ready then
				g.AttackIndex = (g.AttackIndex % 3) + 1
				local kind = ({ "Slam", "Charge", "Orbs" })[g.AttackIndex]
				if kind == "Slam" and dist > atk.Radius * 1.2 then
					kind = "Orbs"
				end
				startAttack(g, kind, target)
			end
		end
		return
	end

	-- Nobody close (or calmed down): wander and slowly recover.
	if not target and t - g.LastPlayerNear > Config.Catch.RegenDelay then
		g.Resistance = math.min(100, g.Resistance + Config.Catch.RegenPerSecond * dt)
	end
	if t < g.PauseUntil then
		return
	end
	local toWander = g.WanderTarget - g.Position
	if toWander.Magnitude < 2 then
		g.WanderTarget = pickWanderTarget(g)
		g.PauseUntil = t + rng:NextNumber(1, 4)
		return
	end
	move(g, toWander, speed * 0.45, dt)
end

local function checkHazards(g)
	if now() < g.HazardCooldownUntil then
		return
	end
	local hazard = inHazard(g.ZoneId, g.Position, g.Def.Size * 0.3)
	if not hazard then
		return
	end
	g.HazardCooldownUntil = now() + 4
	g.StunUntil = now() + Config.Catch.StunSeconds
	local before = g.Resistance
	g.Resistance = math.max(0, g.Resistance - g.Def.HazardDrop)
	shockwave(g.Position, g.Def.Size, hazard.Part.Color)
	local text = string.format(
		"%s stumbled into the %s! Resistance -%d",
		g.Def.Name,
		hazard.Name,
		math.floor(before - g.Resistance + 0.5)
	)
	for _, player in playersNear(g.Position, 90) do
		notifyThrottled(player, text, "weaken")
	end
end

local function render(g)
	local bob = if g.Moving then math.abs(math.sin(now() * 10)) * 0.4 else math.sin(now() * 2) * 0.15
	if isStunned(g) then
		bob = 0
	end
	local pos = g.Position + Vector3.new(0, g.HalfHeight + bob, 0)
	local facing = if g.Facing.Magnitude > 0.01 then g.Facing else Vector3.new(0, 0, -1)
	local cf = CFrame.lookAt(pos, pos + facing)
	if isStunned(g) then
		cf *= CFrame.Angles(0, 0, math.sin(now() * 25) * 0.15)
	end
	g.Model:PivotTo(cf)
end

----------------------------------------------------------------------
-- Spawning
----------------------------------------------------------------------
local spawnGuardian

local function scheduleRespawn(id: string)
	task.delay(Config.Guardians[id].Respawn, function()
		spawnGuardian(id)
	end)
end

function spawnGuardian(id: string)
	local def = Config.Guardians[id]
	local zone = Config.Zones[def.Zone]
	local model = GuardianModels.Build(id)
	model:SetAttribute("GuardianId", id)

	local g = {
		Id = id,
		Def = def,
		Model = model,
		ZoneId = def.Zone,
		ZoneCenter = Config.ZoneCenter(def.Zone),
		ZoneRadius = zone.Radius - 6,
		Position = Vector3.zero,
		Facing = Vector3.new(0, 0, -1),
		HalfHeight = def.Size / 2,
		Resistance = 100,
		FedFavorite = false,
		StunUntil = 0,
		SlowUntil = 0,
		EnragedUntil = 0,
		CalmUntil = 0,
		NextAttack = 0,
		HazardCooldownUntil = 0,
		LastPlayerNear = 0,
		PauseUntil = 0,
		AttackIndex = 0,
		Busy = false,
		Dashing = false,
		Moving = false,
		Capturing = false,
		Alive = true,
	}
	g.Position = pickWanderTarget(g)
	g.WanderTarget = pickWanderTarget(g)
	guardians[model] = g
	syncAttributes(g)
	render(g)
	model.Parent = folder

	if def.Announce then
		Remotes.Announce:FireAllClients(string.format("A legendary %s has appeared in %s!", def.Name, zone.Name))
	end
	return g
end

----------------------------------------------------------------------
-- Public API used by the action handlers
----------------------------------------------------------------------
function GuardianService.FromModel(model: Instance?)
	if typeof(model) ~= "Instance" then
		return nil
	end
	local g = guardians[model :: Model]
	if g and canAct(g) then
		return g
	end
	return nil
end

function GuardianService.Chance(g, flaskMult: number, luck: number): number
	return CatchMath.Chance({
		BaseRate = g.Def.BaseRate,
		FlaskMult = flaskMult,
		Resistance = g.Resistance,
		FedFavorite = g.FedFavorite,
		Stunned = isStunned(g),
		Slowed = isSlowed(g),
		Luck = luck,
	})
end

function GuardianService.GroundPosition(g): Vector3
	return g.Position
end

-- Live, catchable guardians.
function GuardianService.All()
	local out = {}
	for _, g in guardians do
		if canAct(g) then
			table.insert(out, g)
		end
	end
	return out
end

function GuardianService.Celebrate(g, color: Color3)
	local root = g.Model.PrimaryPart
	if not root then
		return
	end
	local burst = Instance.new("ParticleEmitter")
	burst.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	burst.Color = ColorSequence.new(color)
	burst.Size = NumberSequence.new(0.8, 0)
	burst.Speed = NumberRange.new(4, 8)
	burst.Lifetime = NumberRange.new(0.8, 1.4)
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Rate = 0
	burst.Parent = root
	burst:Emit(40)
	task.delay(2, function()
		burst:Destroy()
	end)
end

function GuardianService.BeginCapture(g)
	g.Capturing = true
	g.Busy = false
	g.Model.Parent = hiddenFolder
end

function GuardianService.EndCapture(g, caught: boolean)
	if caught then
		g.Alive = false
		guardians[g.Model] = nil
		g.Model:Destroy()
		scheduleRespawn(g.Id)
		return
	end
	-- Burst out, furious.
	g.Capturing = false
	g.FedFavorite = false
	g.CalmUntil = 0
	g.StunUntil = 0
	g.Resistance = math.min(100, g.Resistance + Config.Catch.BreakFreeResistance)
	g.EnragedUntil = now() + Config.Catch.EnragedSeconds
	g.NextAttack = now() + 0.8
	g.Model.Parent = folder
	syncAttributes(g)
	render(g)
end

function GuardianService.ApplyDraught(g, power: number, player: Player)
	GuardianService.Weaken(g, power, player, "Draught hit")
	g.SlowUntil = now() + Config.DraughtSlowSeconds
	shockwave(g.Position, g.Def.Size, Color3.fromRGB(140, 255, 160))
end

function GuardianService.Feed(g, isFavorite: boolean)
	if isFavorite then
		g.FedFavorite = true
		g.CalmUntil = now() + Config.Catch.CalmSeconds
		g.EnragedUntil = 0
	end
end

function GuardianService.Start()
	folder = Instance.new("Folder")
	folder.Name = "Guardians"
	folder.Parent = workspace

	effects = Instance.new("Folder")
	effects.Name = "Effects"
	effects.Parent = workspace

	hiddenFolder = Instance.new("Folder")
	hiddenFolder.Name = "CapturingGuardians"
	hiddenFolder.Parent = ServerStorage

	for _, id in Config.GuardianOrder do
		for _ = 1, Config.Guardians[id].Count do
			spawnGuardian(id)
		end
	end

	RunService.Heartbeat:Connect(function(dt)
		for _, g in guardians do
			if canAct(g) then
				think(g, dt)
				checkHazards(g)
				syncAttributes(g)
				render(g)
			end
		end
	end)

	-- Hazards hurt players too, so luring a guardian into one is a risk.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, hazard in WorldBuilder.Hazards do
				for _, player in playersNear(hazard.Position, hazard.Radius) do
					damagePlayer(player, Config.HazardPlayerDamage)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastNotify[player] = nil
	end)
end

return GuardianService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Harvest</string>
          <string name="Source"><![CDATA[-- Ingredient nodes: hold the prompt to pick, the node regrows after a while.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PlayerData = require(script.Parent.PlayerData)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Harvest = {}

local function setVisible(node: Model, visible: boolean)
	for _, d in node:GetDescendants() do
		if d:IsA("BasePart") then
			if d:GetAttribute("BaseTransparency") == nil then
				d:SetAttribute("BaseTransparency", d.Transparency)
			end
			d.Transparency = if visible then d:GetAttribute("BaseTransparency") :: number else 1
		elseif d:IsA("ParticleEmitter") or d:IsA("PointLight") or d:IsA("ProximityPrompt") then
			d.Enabled = visible
		end
	end
end

local function hook(node: Model)
	local ingredientId = node:GetAttribute("IngredientId") :: string
	local def = Config.Ingredients[ingredientId]
	local prompt = node:FindFirstChild("HarvestPrompt", true) :: ProximityPrompt
	local ready = true

	prompt.Triggered:Connect(function(player)
		if not ready then
			return
		end
		ready = false
		setVisible(node, false)

		local amount = if def.Tier <= 1 then 2 else 1
		PlayerData.Update(player, function(data)
			data.Ingredients[ingredientId] = (data.Ingredients[ingredientId] or 0) + amount
			return true
		end)
		Remotes.Notify:FireClient(player, string.format("+%d %s", amount, def.Name), "item")

		task.delay(def.Respawn, function()
			ready = true
			setVisible(node, true)
		end)
	end)
end

function Harvest.Start()
	for _, node in WorldBuilder.IngredientNodes do
		hook(node)
	end
end

return Harvest
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[-- Loads, caches and saves each player's data with DataStoreService.
-- Every change goes through PlayerData.Update so the client always gets a
-- fresh snapshot.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local STORE_NAME = "BrewGuardians_v1"
local AUTOSAVE_SECONDS = 120
local RETRIES = 4

local PlayerData = {}

local store: DataStore? = nil
local storeOk = game.PlaceId ~= 0 and pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local cache: { [Player]: any } = {}
local canSave: { [Player]: boolean } = {}
local loadedSignal = Instance.new("BindableEvent")
PlayerData.Loaded = loadedSignal.Event -- (player, data)

local function deepCopy(t)
	local out = {}
	for k, v in t do
		out[k] = if type(v) == "table" then deepCopy(v) else v
	end
	return out
end

local function template()
	local data = {
		Version = 1,
		Coins = Config.StartingData.Coins,
		Vials = Config.StartingData.Vials,
		PotLevel = 1,
		Flasks = {},
		Draughts = {},
		Ingredients = {},
		Guardians = {}, -- array of { Uid, Id, Mutation, CaughtAt }
		Journal = {}, -- [guardianId] = { Seen, Caught, FavoriteKnown, Tried = {} }
		PendingCoins = 0,
		LuckUntil = 0,
		Purchases = {},
		Stats = { Throws = 0, Catches = 0, NearMisses = 0, Brews = 0 },
	}
	for _, f in Config.Flasks do
		data.Flasks[f.Id] = Config.StartingData.Flasks[f.Id] or 0
	end
	for _, d in Config.Draughts do
		data.Draughts[d.Id] = 0
	end
	for _, id in Config.IngredientOrder do
		data.Ingredients[id] = Config.StartingData.Ingredients[id] or 0
	end
	return data
end

-- Fill in any keys a newer version of the game added.
local function reconcile(data, base)
	for k, v in base do
		if data[k] == nil then
			data[k] = if type(v) == "table" then deepCopy(v) else v
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil and #v == 0 then
			reconcile(data[k], v)
		end
	end
	return data
end

local function withRetries(fn)
	local lastErr
	for attempt = 1, RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		-- No point retrying when Studio simply has API access turned off.
		local message = tostring(result)
		if message:find("StudioAccessToApisNotAllowed") or message:find("403") or message:find("publish") then
			break
		end
		task.wait(attempt)
	end
	return false, lastErr
end

local function keyFor(player: Player)
	return "p_" .. player.UserId
end

function PlayerData.Push(player: Player)
	local data = cache[player]
	if data then
		Remotes.StateUpdate:FireClient(player, data)
	end
end

function PlayerData.Get(player: Player)
	return cache[player]
end

function PlayerData.WaitFor(player: Player)
	while player.Parent and not cache[player] do
		task.wait(0.1)
	end
	return cache[player]
end

-- fn mutates data in place. Return false from fn to signal "no change".
function PlayerData.Update(player: Player, fn: (any) -> boolean?)
	local data = cache[player]
	if not data then
		return false
	end
	local result = fn(data)
	if result ~= false then
		PlayerData.Push(player)
	end
	return result ~= false
end

function PlayerData.NewUid(): string
	return HttpService:GenerateGUID(false)
end

function PlayerData.Save(player: Player)
	local data = cache[player]
	local activeStore = store
	if not data or not canSave[player] or not activeStore then
		return
	end
	local ok, err = withRetries(function()
		activeStore:UpdateAsync(keyFor(player), function()
			return data
		end)
	end)
	if not ok then
		warn("[PlayerData] save failed for", player.Name, err)
	end
end

local function load(player: Player)
	local data
	local activeStore = store
	if activeStore then
		local ok, result = withRetries(function()
			return activeStore:GetAsync(keyFor(player))
		end)
		if ok then
			data = result
			canSave[player] = true
		else
			-- Never overwrite a save we failed to read.
			warn("[PlayerData] load failed, this session will not save:", result)
			canSave[player] = false
		end
	else
		canSave[player] = false
	end

	if not player.Parent then
		return
	end

	data = reconcile(data or template(), template())
	cache[player] = data

	if not canSave[player] and RunService:IsStudio() then
		Remotes.Notify:FireClient(
			player,
			"Studio test: progress won't save until you publish and enable API access (Game Settings > Security).",
			"info"
		)
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = leaderstats
	local caught = Instance.new("IntValue")
	caught.Name = "Caught"
	caught.Parent = leaderstats
	leaderstats.Parent = player

	PlayerData.Push(player)
	loadedSignal:Fire(player, data)
end

local function syncLeaderstats()
	for player, data in cache do
		local stats = player:FindFirstChild("leaderstats")
		if stats then
			(stats :: any).Coins.Value = math.floor(data.Coins);
			(stats :: any).Caught.Value = #data.Guardians
		end
	end
end

function PlayerData.Start()
	if not storeOk then
		warn("[PlayerData] DataStoreService unavailable, progress will not save")
	end

	Remotes.RequestState.OnServerEvent:Connect(PlayerData.Push)

	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		PlayerData.Save(player)
		cache[player] = nil
		canSave[player] = nil
	end)

	game:BindToClose(function()
		local pending = 0
		for player in cache do
			pending += 1
			task.spawn(function()
				PlayerData.Save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player in cache do
				task.spawn(PlayerData.Save, player)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			syncLeaderstats()
		end
	end)
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Plots</string>
          <string name="Source"><![CDATA[-- Player plots: a fenced garden with your cauldron, your caught guardians on
-- display pedestals, and the coin chest they fill.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Build = require(script.Parent.Build)
local GuardianModels = require(script.Parent.GuardianModels)
local PlayerData = require(script.Parent.PlayerData)
local Props = require(script.Parent.Props)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Plots = {}

type Plot = {
	Index: number,
	Owner: Player?,
	Frame: CFrame, -- floor level, -Z faces the hub
	Model: Model,
	Floor: BasePart,
	Brew: BasePart,
	SetOwnerText: (string) -> (),
	PendingLabel: TextLabel,
	Displays: Folder,
	Pedestals: { { CFrame: CFrame, Top: number } },
	BrewPrompt: ProximityPrompt,
	CollectPrompt: ProximityPrompt,
}

local plots: { Plot } = {}
local byPlayer: { [Player]: Plot } = {}

local FLOOR_Y = 1 -- plot floor height above the ground
local GRASS = Color3.fromRGB(110, 175, 90)
local GRASS_OWNED = Color3.fromRGB(120, 190, 95)
local STONE = Color3.fromRGB(160, 154, 146)
local RARITY_COLORS = {
	Common = Color3.fromRGB(200, 200, 200),
	Uncommon = Color3.fromRGB(110, 230, 120),
	Rare = Color3.fromRGB(90, 160, 255),
	Legendary = Color3.fromRGB(255, 190, 60),
}

local function at(plot, x: number, z: number, y: number?): CFrame
	return plot.Frame * CFrame.new(x, y or 0, z)
end

local function buildPlot(index: number, parent: Instance): Plot
	local center = Config.PlotCenter(index)
	local frame = CFrame.lookAt(center, Vector3.zero) * CFrame.new(0, FLOOR_Y, 0)
	local half = Config.PlotSize / 2
	local model = Build.model("Plot" .. index, parent)

	local plot = {
		Index = index,
		Owner = nil,
		Frame = frame,
		Model = model,
		Displays = Instance.new("Folder"),
		Pedestals = {},
	} :: any

	-- Stone border and grass floor
	Build.part(model, frame * CFrame.new(0, -FLOOR_Y / 2, 0), Vector3.new(half * 2 + 2, FLOOR_Y, half * 2 + 2), STONE, Enum.Material.Cobblestone)
	plot.Floor = Build.part(model, frame * CFrame.new(0, 0.05, 0), Vector3.new(half * 2 - 2, 0.1, half * 2 - 2), GRASS, Enum.Material.Grass)

	-- Fence on three sides, gate gap at the front
	local y = frame.Position.Y
	local function corner(x, z)
		return (frame * CFrame.new(x, 0, z)).Position
	end
	Props.FenceRun(model, corner(-half + 1, half - 1), corner(half - 1, half - 1), y)
	Props.FenceRun(model, corner(-half + 1, -half + 1), corner(-half + 1, half - 1), y)
	Props.FenceRun(model, corner(half - 1, -half + 1), corner(half - 1, half - 1), y)
	Props.FenceRun(model, corner(-half + 1, -half + 1), corner(-7, -half + 1), y)
	Props.FenceRun(model, corner(7, -half + 1), corner(half - 1, -half + 1), y)

	-- Gate lanterns and owner sign
	Props.Lantern(model, at(plot, -8, -half + 1), 8)
	Props.Lantern(model, at(plot, 8, -half + 1) * CFrame.Angles(0, math.pi, 0), 8)
	local _, setText = Props.SignBoard(model, at(plot, -17, -half + 3), "Empty plot", 14, Color3.fromRGB(110, 76, 50))
	plot.SetOwnerText = setText

	-- Stepping-stone path from the gate
	for i = 0, 5 do
		Build.cylinder(model, at(plot, (i % 2) * 1.2 - 0.6, -half + 3 + i * 4, 0.1), 0.15, 3.2, Color3.fromRGB(190, 182, 170), Enum.Material.Slate)
	end

	-- Brewing corner: cauldron, shelf of flasks, crates
	local _, brew, belly = Props.Cauldron(model, at(plot, -14, -12), 3.2, Color3.fromRGB(120, 255, 150))
	plot.Brew = brew
	local prompt = WorldBuilder.Prompt(belly, "Brew", "Your Cauldron", 12)
	prompt.Name = "BrewPrompt"
	local shelf = at(plot, -24, -10) * CFrame.Angles(0, math.rad(90), 0)
	Build.part(model, shelf * CFrame.new(0, 3, 0.6), Vector3.new(8, 6, 0.4), Color3.fromRGB(110, 76, 50), Enum.Material.WoodPlanks)
	local flaskColors = { Color3.fromRGB(196, 132, 92), Color3.fromRGB(140, 220, 255), Color3.fromRGB(200, 120, 255), Color3.fromRGB(255, 240, 150) }
	for row = 0, 1 do
		Build.part(model, shelf * CFrame.new(0, 1.8 + row * 2.2, 0), Vector3.new(8, 0.25, 1.4), Color3.fromRGB(130, 92, 60), Enum.Material.WoodPlanks)
		for i = 1, 4 do
			local col = flaskColors[((i + row) % 4) + 1]
			Build.ellipsoid(model, shelf * CFrame.new(-4.5 + i * 1.8, 2.4 + row * 2.2, 0), Vector3.new(1, 1.1, 1), col, Enum.Material.Glass, { Transparency = 0.1 })
			Build.cylinder(model, shelf * CFrame.new(-4.5 + i * 1.8, 3.1 + row * 2.2, 0), 0.4, 0.35, col, Enum.Material.Glass)
		end
	end
	Build.part(model, at(plot, -21, -18, 1.2) * CFrame.Angles(0, 0.3, 0), Vector3.new(2.4, 2.4, 2.4), Color3.fromRGB(150, 105, 65), Enum.Material.WoodPlanks)
	Build.part(model, at(plot, -21.5, -18, 3.2) * CFrame.Angles(0, -0.2, 0), Vector3.new(1.8, 1.6, 1.8), Color3.fromRGB(150, 105, 65), Enum.Material.WoodPlanks)

	-- Coin chest
	local _, lid = Props.CoinChest(model, at(plot, 15, -14) * CFrame.Angles(0, math.rad(180), 0))
	local collect = WorldBuilder.Prompt(lid, "Collect", "Coins", 10)
	collect.Name = "CollectPrompt"
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 46)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.MaxDistance = 120
	gui.Parent = lid
	local pending = Instance.new("TextLabel")
	pending.Size = UDim2.fromScale(1, 1)
	pending.BackgroundTransparency = 1
	pending.Font = Enum.Font.FredokaOne
	pending.TextScaled = true
	pending.TextColor3 = Color3.fromRGB(255, 225, 110)
	pending.TextStrokeTransparency = 0.2
	pending.Text = ""
	pending.Parent = gui
	plot.PendingLabel = pending

	-- Display pedestals: 4 x 3 in the back half
	for row = 0, 2 do
		for col = 0, 3 do
			local cf = at(plot, -16.5 + col * 11, 2 + row * 9.5)
			local _, top = Props.Pedestal(model, cf, Color3.fromRGB(150, 140, 170))
			table.insert(plot.Pedestals, { CFrame = cf, Top = top })
		end
	end

	-- Flowers along the back fence
	for i = -2, 2 do
		Props.FlowerPatch(model, at(plot, i * 10, half - 4, 0.1), 2.5)
	end

	plot.Displays.Name = "Displays"
	plot.Displays.Parent = model
	model.PrimaryPart = plot.Floor

	plot.BrewPrompt = prompt
	plot.CollectPrompt = collect

	return plot :: Plot
end

local function hookPrompts(plot)
	plot.BrewPrompt.Triggered:Connect(function(player)
		if plot.Owner ~= player then
			Remotes.Notify:FireClient(player, "That's someone else's cauldron. Use yours, or the big one in the hub.", "error")
			return
		end
		Remotes.OpenUI:FireClient(player, "Brew")
	end)

	plot.CollectPrompt.Triggered:Connect(function(player)
		if plot.Owner ~= player then
			return
		end
		local amount = 0
		PlayerData.Update(player, function(data)
			amount = math.floor(data.PendingCoins)
			if amount <= 0 then
				return false
			end
			data.PendingCoins -= amount
			data.Coins += amount
			return true
		end)
		if amount > 0 then
			Remotes.Notify:FireClient(player, string.format("+%d coins", amount), "coins")
		end
	end)
end

----------------------------------------------------------------------
-- Displays
----------------------------------------------------------------------
local function showGuardians(plot: Plot, entries: { any })
	plot.Displays:ClearAllChildren()
	local list = table.clone(entries)
	table.sort(list, function(a, b)
		return Config.GuardianIncome(a) > Config.GuardianIncome(b)
	end)
	for i = 1, math.min(#list, #plot.Pedestals) do
		local entry = list[i]
		local def = Config.Guardians[entry.Id]
		if def then
			local slot = plot.Pedestals[i]
			local mutation = Config.Mutations[entry.Mutation or 0]
			local height = def.Size * (if mutation then mutation.Scale else 1)
			local model = GuardianModels.Build(entry.Id, entry.Mutation)
			model:PivotTo(slot.CFrame * CFrame.new(0, slot.Top + def.Size / 2, 0)) -- faces the gate
			GuardianModels.SitOnGround(model, slot.CFrame.Position.Y + slot.Top)
			model:SetAttribute("PlotGuardian", true)
			model:SetAttribute("DisplayName", Config.GuardianDisplayName(entry))
			model:SetAttribute("Income", Config.GuardianIncome(entry))

			-- glowing ring in the guardian's rarity colour
			local ring = Instance.new("Model")
			ring.Name = "RarityRing"
			Build.ring(ring, slot.CFrame * CFrame.new(0, slot.Top + 0.05, 0), 3.1, 0.3, 16, RARITY_COLORS[def.Rarity], Enum.Material.Neon)
			ring.Parent = model

			local gui = Instance.new("BillboardGui")
			gui.Size = UDim2.fromOffset(180, 40)
			gui.StudsOffsetWorldSpace = Vector3.new(0, height * 0.75 + 2, 0)
			gui.MaxDistance = 60
			gui.Adornee = model.PrimaryPart
			gui.Parent = model
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextColor3 = RARITY_COLORS[def.Rarity]
			label.TextStrokeTransparency = 0.3
			label.Text = string.format("%s\n+%d/s", Config.GuardianDisplayName(entry), math.floor(Config.GuardianIncome(entry)))
			label.Parent = gui

			model.Parent = plot.Displays
		end
	end
end

function Plots.Refresh(player: Player)
	local plot = byPlayer[player]
	local data = PlayerData.Get(player)
	if plot and data then
		showGuardians(plot, data.Guardians)
	end
end

-- Used by the offline preview renderer: fills a plot with one of each guardian.
function Plots.PreviewFill(index: number)
	local plot = plots[index]
	local entries = {}
	for i, id in Config.GuardianOrder do
		table.insert(entries, { Id = id, Mutation = if i == 1 then 2 else 0 })
	end
	plot.SetOwnerText("Builderman's Plot")
	showGuardians(plot, entries)
end

----------------------------------------------------------------------
-- Ownership, spawning, brewing helpers
----------------------------------------------------------------------
function Plots.Get(player: Player): Plot?
	return byPlayer[player]
end

function Plots.SpawnCFrame(player: Player): CFrame?
	local plot = byPlayer[player]
	if not plot then
		return nil
	end
	local pos = (plot.Frame * CFrame.new(-4, 4, -18)).Position
	local look = (plot.Frame * CFrame.new(-14, 4, -12)).Position
	return CFrame.lookAt(pos, look)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- The cauldron a player is standing at: their own, or the public one.
function Plots.NearbyBrew(player: Player, range: number): BasePart?
	local root = rootOf(player)
	if not root then
		return nil
	end
	local plot = byPlayer[player]
	if plot and (root.Position - plot.Brew.Position).Magnitude <= range then
		return plot.Brew
	end
	local public = WorldBuilder.PublicBrew
	if public and (root.Position - public.Position).Magnitude <= range + 8 then
		return public
	end
	return nil
end

function Plots.BrewEffect(brew: BasePart, color: Color3)
	local original = brew:GetAttribute("BaseColor") or brew.Color
	brew:SetAttribute("BaseColor", original)
	brew.Color = color
	local burst = Instance.new("ParticleEmitter")
	burst.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	burst.Color = ColorSequence.new(color)
	burst.LightEmission = 1
	burst.Speed = NumberRange.new(10, 18)
	burst.Lifetime = NumberRange.new(0.6, 1.2)
	burst.Size = NumberSequence.new(1, 0)
	burst.SpreadAngle = Vector2.new(35, 35)
	burst.EmissionDirection = Enum.NormalId.Right
	burst.Rate = 0
	burst.Parent = brew
	burst:Emit(60)
	task.delay(2, function()
		burst:Destroy()
		TweenService:Create(brew, TweenInfo.new(1), { Color = original }):Play()
	end)
end

local function assign(player: Player)
	for _, plot in plots do
		if not plot.Owner then
			plot.Owner = player
			byPlayer[player] = plot
			plot.SetOwnerText(player.DisplayName .. "'s Plot")
			plot.Floor.Color = GRASS_OWNED
			Plots.Refresh(player)
			return plot
		end
	end
	Remotes.Notify:FireClient(player, "All plots are taken. You can still brew at the hub cauldron!", "error")
	return nil
end

local function release(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	plot.Owner = nil
	byPlayer[player] = nil
	plot.SetOwnerText("Empty plot")
	plot.PendingLabel.Text = ""
	plot.Floor.Color = GRASS
	plot.Displays:ClearAllChildren()
end

local function onCharacter(player: Player, character: Model)
	task.wait(0.2)
	local cf = Plots.SpawnCFrame(player)
	if cf and character.Parent then
		character:PivotTo(cf)
	end
end

function Plots.Build()
	local folder = Instance.new("Folder")
	folder.Name = "Plots"
	folder.Parent = workspace
	for i = 1, Config.PlotCount do
		table.insert(plots, buildPlot(i, folder))
	end
end

function Plots.Start()
	Plots.Build()
	for _, plot in plots do
		hookPrompts(plot)
	end

	PlayerData.Loaded:Connect(function(player)
		assign(player)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end)
	local function hookCharacter(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
	end
	Players.PlayerAdded:Connect(hookCharacter)
	for _, player in Players:GetPlayers() do
		hookCharacter(player)
	end
	Players.PlayerRemoving:Connect(release)

	-- Income
	task.spawn(function()
		while true do
			task.wait(Config.IncomeTickSeconds)
			for player, plot in byPlayer do
				local data = PlayerData.Get(player)
				if data then
					local perSecond = 0
					for _, entry in data.Guardians do
						perSecond += Config.GuardianIncome(entry)
					end
					local cap = perSecond * Config.MaxPendingIncomeSeconds
					data.PendingCoins = math.min(data.PendingCoins + perSecond * Config.IncomeTickSeconds, cap)
					plot.PendingLabel.Text = if perSecond > 0
						then string.format("%d coins  (+%d/s)", math.floor(data.PendingCoins), math.floor(perSecond))
						else "Catch guardians to earn"
				end
			end
		end
	end)
end

return Plots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Props</string>
          <string name="Source"><![CDATA[-- Reusable scenery: cauldrons, fences, lanterns, trees, rocks, crystals,
-- gates, stalls, pedestals and ingredient plants. Every builder takes a
-- ground CFrame (y = floor level, facing -Z) and returns a Model.

local Build = require(script.Parent.Build)

local Props = {}

local IRON = Color3.fromRGB(46, 44, 54)
local IRON_LIGHT = Color3.fromRGB(78, 74, 88)
local WOOD = Color3.fromRGB(124, 86, 56)
local WOOD_DARK = Color3.fromRGB(92, 62, 40)
local STONE = Color3.fromRGB(150, 146, 140)
local STONE_DARK = Color3.fromRGB(110, 106, 102)

local rng = Random.new(77)
local function jitter(a: number, b: number): number
	return rng:NextNumber(a, b)
end

----------------------------------------------------------------------
-- Cauldron: round iron belly, rim, glowing brew, legs and a fire below.
-- Returns model, brewPart (for colour changes / effects), promptPart.
----------------------------------------------------------------------
function Props.Cauldron(parent: Instance, ground: CFrame, r: number, brewColor: Color3): (Model, BasePart, BasePart)
	local m = Build.model("Cauldron", parent)
	local lift = r * 0.55 -- room for the fire underneath
	local c = ground * CFrame.new(0, lift + r * 0.7, 0)

	-- legs
	for i = 1, 3 do
		local a = (i / 3) * math.pi * 2
		local legCf = ground * CFrame.Angles(0, a, 0) * CFrame.new(r * 0.62, lift * 0.55, 0) * CFrame.Angles(0, 0, math.rad(-12))
		Build.cylinder(m, legCf, lift * 1.2, r * 0.18, IRON, Enum.Material.Metal)
		Build.ellipsoid(m, ground * CFrame.Angles(0, a, 0) * CFrame.new(r * 0.72, r * 0.06, 0), Vector3.new(r * 0.3, r * 0.12, r * 0.3), IRON, Enum.Material.Metal)
	end

	-- fire: crossed logs, embers, flame
	for i = 0, 2 do
		local log = Build.cylinder(m, ground * CFrame.Angles(0, i * math.pi / 3, 0) * CFrame.new(0, r * 0.1, 0) * CFrame.Angles(math.rad(90), 0, 0), r * 1.0, r * 0.18, WOOD_DARK, Enum.Material.Wood)
		log.CanCollide = false
	end
	local ember = Build.ellipsoid(m, ground * CFrame.new(0, r * 0.18, 0), Vector3.new(r * 0.55, r * 0.25, r * 0.55), Color3.fromRGB(255, 120, 40), Enum.Material.Neon, { CanCollide = false })
	local fire = Instance.new("Fire")
	fire.Size = r * 1.6
	fire.Heat = 6
	fire.Color = Color3.fromRGB(255, 140, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 220, 90)
	fire.Parent = ember
	Build.light(ember, Color3.fromRGB(255, 150, 60), r * 4, 1.5)

	-- belly
	local belly = Build.ellipsoid(m, c, Vector3.new(r * 2, r * 1.5, r * 2), IRON, Enum.Material.Metal)
	-- neck, brew surface and thick rolled rim
	Build.cylinder(m, c * CFrame.new(0, r * 0.6, 0), r * 0.2, r * 1.66, IRON, Enum.Material.Metal)
	local brew = Build.cylinder(m, c * CFrame.new(0, r * 0.7, 0), 0.1, r * 1.5, brewColor, Enum.Material.Neon, { CanCollide = false })
	brew.Name = "Brew"
	Build.ring(m, c * CFrame.new(0, r * 0.72, 0), r * 0.84, r * 0.22, 20, IRON_LIGHT, Enum.Material.Metal)
	-- bubbles sitting on the surface
	for i = 1, 4 do
		local a = jitter(0, math.pi * 2)
		local d = jitter(0.1, 0.5) * r
		local s = jitter(0.12, 0.26) * r
		Build.ellipsoid(m, c * CFrame.new(math.cos(a) * d, r * 0.74, math.sin(a) * d), Vector3.new(s, s * 0.7, s), brewColor:Lerp(Color3.new(1, 1, 1), 0.35), Enum.Material.Neon, { CanCollide = false })
	end
	-- handles
	for _, side in { -1, 1 } do
		Build.ring(m, c * CFrame.new(side * r * 1.0, r * 0.35, 0) * CFrame.Angles(0, 0, math.rad(90)), r * 0.22, r * 0.07, 10, IRON_LIGHT, Enum.Material.Metal)
	end

	Build.light(brew, brewColor, r * 5, 1.2)
	local bubbles = Build.sparkles(brew, brewColor:Lerp(Color3.new(1, 1, 1), 0.4), 8, r * 0.18)
	bubbles.Name = "Bubbles"
	bubbles.EmissionDirection = Enum.NormalId.Right -- cylinder's top face
	bubbles.Speed = NumberRange.new(r * 0.6, r * 1.2)
	bubbles.SpreadAngle = Vector2.new(25, 25)

	m.PrimaryPart = belly
	return m, brew, belly
end

----------------------------------------------------------------------
-- Fences, lanterns, benches, signs
----------------------------------------------------------------------
function Props.FenceRun(parent: Instance, a: Vector3, b: Vector3, y: number, postEvery: number?)
	local m = Build.model("Fence", parent)
	local length = (b - a).Magnitude
	local dir = (b - a).Unit
	local count = math.max(1, math.floor(length / (postEvery or 6)))
	for i = 0, count do
		local p = a:Lerp(b, i / count)
		Build.cylinder(m, CFrame.new(p.X, y + 2, p.Z), 4, 0.8, WOOD_DARK, Enum.Material.Wood)
		Build.ellipsoid(m, CFrame.new(p.X, y + 4.1, p.Z), Vector3.new(0.95, 0.6, 0.95), WOOD, Enum.Material.Wood)
	end
	local mid = (a + b) / 2
	for _, h in { 1.5, 3 } do
		Build.part(m, CFrame.lookAt(Vector3.new(mid.X, y + h, mid.Z), Vector3.new(mid.X, y + h, mid.Z) + dir), Vector3.new(0.3, 0.5, length), WOOD, Enum.Material.WoodPlanks)
	end
	return m
end

function Props.Lantern(parent: Instance, ground: CFrame, height: number?, color: Color3?)
	local h = height or 9
	local m = Build.model("Lantern", parent)
	Build.cylinder(m, ground * CFrame.new(0, 0.3, 0), 0.6, 1.8, STONE_DARK, Enum.Material.Slate)
	Build.cylinder(m, ground * CFrame.new(0, h / 2, 0), h, 0.45, IRON, Enum.Material.Metal)
	Build.part(m, ground * CFrame.new(0.9, h - 0.2, 0), Vector3.new(1.8, 0.25, 0.25), IRON, Enum.Material.Metal)
	local glow = Build.part(m, ground * CFrame.new(1.6, h - 1.2, 0), Vector3.new(0.9, 1.2, 0.9), color or Color3.fromRGB(255, 210, 120), Enum.Material.Neon, { CanCollide = false })
	Build.part(m, ground * CFrame.new(1.6, h - 0.5, 0), Vector3.new(1.2, 0.25, 1.2), IRON, Enum.Material.Metal)
	Build.part(m, ground * CFrame.new(1.6, h - 1.9, 0), Vector3.new(1.1, 0.2, 1.1), IRON, Enum.Material.Metal)
	Build.light(glow, color or Color3.fromRGB(255, 200, 120), 18, 1.4)
	return m
end

function Props.Bench(parent: Instance, ground: CFrame)
	local m = Build.model("Bench", parent)
	Build.part(m, ground * CFrame.new(0, 1.6, 0), Vector3.new(6, 0.35, 1.8), WOOD, Enum.Material.WoodPlanks)
	Build.part(m, ground * CFrame.new(0, 2.8, 0.8) * CFrame.Angles(math.rad(-10), 0, 0), Vector3.new(6, 1.2, 0.3), WOOD, Enum.Material.WoodPlanks)
	for _, x in { -2.5, 2.5 } do
		Build.part(m, ground * CFrame.new(x, 0.8, 0), Vector3.new(0.4, 1.6, 1.6), IRON, Enum.Material.Metal)
	end
	return m
end

-- Two posts and a board with text on both sides. Returns the model and a
-- function that changes the text.
function Props.SignBoard(parent: Instance, ground: CFrame, text: string, width: number?, boardColor: Color3?): (Model, (string) -> ())
	local w = width or 10
	local m = Build.model("SignBoard", parent)
	for _, x in { -w / 2 + 0.5, w / 2 - 0.5 } do
		Build.cylinder(m, ground * CFrame.new(x, 3, 0), 6, 0.6, WOOD_DARK, Enum.Material.Wood)
	end
	local board = Build.part(m, ground * CFrame.new(0, 5, 0), Vector3.new(w, 2.6, 0.4), boardColor or WOOD, Enum.Material.WoodPlanks)
	Build.part(m, ground * CFrame.new(0, 6.45, 0), Vector3.new(w + 0.6, 0.3, 0.7), WOOD_DARK, Enum.Material.Wood)
	local front = Build.surfaceText(board, Enum.NormalId.Front, text, Color3.fromRGB(255, 245, 225))
	local back = Build.surfaceText(board, Enum.NormalId.Back, text, Color3.fromRGB(255, 245, 225))
	return m, function(newText: string)
		front.Text = newText
		back.Text = newText
	end
end

----------------------------------------------------------------------
-- Nature
----------------------------------------------------------------------
function Props.Tree(parent: Instance, ground: CFrame, style: string)
	local m = Build.model("Tree", parent)
	local h = jitter(10, 16)
	if style == "Pine" or style == "SnowPine" then
		Build.cylinder(m, ground * CFrame.new(0, h * 0.35, 0), h * 0.7, 1.4, WOOD_DARK, Enum.Material.Wood)
		local green = if style == "SnowPine" then Color3.fromRGB(70, 110, 95) else Color3.fromRGB(52, 120, 70)
		for i = 0, 3 do
			local w = (4 - i) * 2.6
			local y = h * 0.3 + i * h * 0.17
			Build.ellipsoid(m, ground * CFrame.new(0, y, 0), Vector3.new(w, h * 0.22, w), green, Enum.Material.Grass)
			if style == "SnowPine" then
				Build.ellipsoid(m, ground * CFrame.new(0, y + h * 0.06, 0), Vector3.new(w * 0.8, h * 0.12, w * 0.8), Color3.fromRGB(240, 248, 255), Enum.Material.Snow)
			end
		end
	elseif style == "Dead" then
		Build.cylinder(m, ground * CFrame.new(0, h * 0.35, 0) * CFrame.Angles(0, 0, math.rad(jitter(-6, 6))), h * 0.7, 1.3, Color3.fromRGB(40, 32, 30), Enum.Material.Wood)
		for i = 1, 3 do
			local a = jitter(0, math.pi * 2)
			Build.cylinder(m, ground * CFrame.new(0, h * jitter(0.4, 0.65), 0) * CFrame.Angles(0, a, 0) * CFrame.Angles(0, 0, math.rad(-50)) * CFrame.new(0, 2, 0), 4, 0.6, Color3.fromRGB(40, 32, 30), Enum.Material.Wood)
			local _ = i
		end
	else -- round leafy tree
		Build.cylinder(m, ground * CFrame.new(0, h * 0.35, 0), h * 0.7, 1.8, WOOD, Enum.Material.Wood)
		local greens = { Color3.fromRGB(80, 160, 80), Color3.fromRGB(100, 180, 85), Color3.fromRGB(65, 140, 70) }
		Build.ellipsoid(m, ground * CFrame.new(0, h * 0.8, 0), Vector3.new(10, 8, 10), greens[1], Enum.Material.Grass)
		for i = 1, 3 do
			local a = (i / 3) * math.pi * 2 + jitter(0, 1)
			Build.ellipsoid(m, ground * CFrame.new(math.cos(a) * 3.5, h * 0.72 + jitter(-1, 1.5), math.sin(a) * 3.5), Vector3.new(7, 6, 7), greens[i], Enum.Material.Grass)
		end
	end
	return m
end

function Props.Rocks(parent: Instance, ground: CFrame, size: number, color: Color3?, material: Enum.Material?)
	local m = Build.model("Rocks", parent)
	local col = color or STONE
	for i = 1, 3 do
		local s = size * (1 - i * 0.22)
		local off = if i == 1 then Vector3.zero else Vector3.new(jitter(-1, 1), 0, jitter(-1, 1)).Unit * size * 0.55
		Build.part(m, ground * CFrame.new(off + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(jitter(-0.4, 0.4), jitter(0, 6), jitter(-0.4, 0.4)), Vector3.new(s, s * 0.75, s * 0.9), col:Lerp(Color3.new(0, 0, 0), i * 0.06), material or Enum.Material.Slate)
	end
	return m
end

function Props.Crystals(parent: Instance, ground: CFrame, size: number, color: Color3, glow: boolean?)
	local m = Build.model("Crystals", parent)
	for i = 1, 5 do
		local h = size * jitter(0.6, 1.3) * (if i == 1 then 1.4 else 1)
		local w = size * 0.22
		local tilt = if i == 1 then CFrame.identity else CFrame.Angles(jitter(-0.5, 0.5), jitter(0, 6), jitter(-0.5, 0.5))
		local base = ground * CFrame.new(jitter(-1, 1) * size * 0.3, 0, jitter(-1, 1) * size * 0.3) * tilt
		local mat = if glow and i == 1 then Enum.Material.Neon else Enum.Material.Glass
		Build.part(m, base * CFrame.new(0, h / 2, 0), Vector3.new(w, h, w), color, mat, { Transparency = if mat == Enum.Material.Glass then 0.15 else 0 })
		Build.tent(m, base * CFrame.new(0, h, 0), w * 1.2, w, color, mat)
	end
	return m
end

function Props.FlowerPatch(parent: Instance, ground: CFrame, radius: number)
	local m = Build.model("Flowers", parent)
	local colors = { Color3.fromRGB(255, 120, 160), Color3.fromRGB(255, 220, 90), Color3.fromRGB(170, 130, 255), Color3.fromRGB(255, 255, 255) }
	for i = 1, 7 do
		local a = jitter(0, math.pi * 2)
		local d = jitter(0, radius)
		local p = ground * CFrame.new(math.cos(a) * d, 0, math.sin(a) * d)
		Build.cylinder(m, p * CFrame.new(0, 0.5, 0), 1, 0.15, Color3.fromRGB(70, 140, 60), nil, { CanCollide = false })
		Build.ellipsoid(m, p * CFrame.new(0, 1.05, 0), Vector3.new(0.7, 0.35, 0.7), colors[(i % #colors) + 1], nil, { CanCollide = false })
	end
	return m
end

function Props.GrassTuft(parent: Instance, ground: CFrame, color: Color3)
	local m = Build.model("Tuft", parent)
	for i = 1, 3 do
		Build.wedge(m, ground * CFrame.Angles(0, i * 2.1, jitter(-0.2, 0.2)) * CFrame.new(0, 0.6, 0), Vector3.new(0.2, 1.2, 0.5), color, Enum.Material.Grass, { CanCollide = false, CastShadow = false })
	end
	return m
end

----------------------------------------------------------------------
-- Architecture
----------------------------------------------------------------------
function Props.Gate(parent: Instance, ground: CFrame, width: number, text: string, accent: Color3)
	local m = Build.model("Gate", parent)
	local h = 16
	for _, x in { -width / 2, width / 2 } do
		Build.part(m, ground * CFrame.new(x, 0.6, 0), Vector3.new(4, 1.2, 4), STONE_DARK, Enum.Material.Cobblestone)
		Build.part(m, ground * CFrame.new(x, h / 2, 0), Vector3.new(3, h, 3), STONE, Enum.Material.Cobblestone)
		Build.part(m, ground * CFrame.new(x, h + 0.4, 0), Vector3.new(3.8, 0.8, 3.8), STONE_DARK, Enum.Material.Cobblestone)
		local orb = Build.ellipsoid(m, ground * CFrame.new(x, h + 1.6, 0), Vector3.new(1.8, 1.8, 1.8), accent, Enum.Material.Neon)
		Build.light(orb, accent, 16, 1.5)
	end
	Build.part(m, ground * CFrame.new(0, h - 1, 0), Vector3.new(width + 3, 1.6, 2.2), WOOD_DARK, Enum.Material.Wood)
	local banner = Build.part(m, ground * CFrame.new(0, h - 3.6, 0), Vector3.new(width * 0.7, 3.2, 0.3), accent:Lerp(Color3.new(0, 0, 0), 0.35), Enum.Material.Fabric)
	Build.surfaceText(banner, Enum.NormalId.Front, text, Color3.new(1, 1, 1))
	Build.surfaceText(banner, Enum.NormalId.Back, text, Color3.new(1, 1, 1))
	return m
end

-- Market stall with a striped awning and a shelf of flasks.
function Props.Stall(parent: Instance, ground: CFrame, stripeA: Color3, stripeB: Color3): (Model, BasePart)
	local m = Build.model("Stall", parent)
	local counter = Build.part(m, ground * CFrame.new(0, 2, 0), Vector3.new(14, 4, 4), WOOD, Enum.Material.WoodPlanks)
	Build.part(m, ground * CFrame.new(0, 4.15, 0), Vector3.new(14.6, 0.3, 4.6), WOOD_DARK, Enum.Material.Wood)
	for _, x in { -6.6, 6.6 } do
		for _, z in { -2, 3.5 } do
			Build.cylinder(m, ground * CFrame.new(x, 5, z), 10, 0.6, WOOD_DARK, Enum.Material.Wood)
		end
	end
	-- awning stripes
	for i = 0, 6 do
		Build.wedge(m, ground * CFrame.new(-6.8 + i * 2.27 + 1.13, 10.6, 0.5) * CFrame.Angles(0, math.pi, 0), Vector3.new(2.27, 1.6, 7), if i % 2 == 0 then stripeA else stripeB, Enum.Material.Fabric)
	end
	-- shelf of flasks behind the counter
	Build.part(m, ground * CFrame.new(0, 6.5, 3.5), Vector3.new(12, 0.3, 1.4), WOOD, Enum.Material.WoodPlanks)
	local colors = { Color3.fromRGB(196, 132, 92), Color3.fromRGB(140, 220, 255), Color3.fromRGB(200, 120, 255), Color3.fromRGB(255, 240, 150) }
	for i = 1, 8 do
		local col = colors[(i % 4) + 1]
		Build.ellipsoid(m, ground * CFrame.new(-5.2 + i * 1.3, 7.2, 3.5), Vector3.new(1, 1.1, 1), col, Enum.Material.Glass, { Transparency = 0.1 })
		Build.cylinder(m, ground * CFrame.new(-5.2 + i * 1.3, 7.9, 3.5), 0.4, 0.35, col, Enum.Material.Glass)
	end
	-- vials on the counter
	for i = 1, 5 do
		Build.cylinder(m, ground * CFrame.new(-4 + i * 1.4, 4.9, -0.6), 1.2, 0.5, Color3.fromRGB(200, 235, 255), Enum.Material.Glass, { Transparency = 0.3 })
	end
	return m, counter
end

function Props.Pedestal(parent: Instance, ground: CFrame, accent: Color3): (Model, number)
	local m = Build.model("Pedestal", parent)
	Build.cylinder(m, ground * CFrame.new(0, 0.4, 0), 0.8, 7.2, STONE_DARK, Enum.Material.Slate)
	Build.cylinder(m, ground * CFrame.new(0, 1.2, 0), 0.8, 6.4, STONE, Enum.Material.Slate)
	Build.ring(m, ground * CFrame.new(0, 1.62, 0), 3.1, 0.25, 16, accent, Enum.Material.Neon)
	return m, 1.6 -- height of the top surface
end

-- Treasure chest overflowing with coins. Returns model, the lid part.
function Props.CoinChest(parent: Instance, ground: CFrame): (Model, BasePart)
	local m = Build.model("CoinChest", parent)
	local gold = Color3.fromRGB(255, 200, 60)
	Build.cylinder(m, ground * CFrame.new(0, 0.2, 0), 0.4, 9, Color3.fromRGB(200, 150, 40), Enum.Material.Neon, { CanCollide = false })
	local box = Build.part(m, ground * CFrame.new(0, 1.6, 0), Vector3.new(5, 2.8, 3.4), WOOD, Enum.Material.WoodPlanks)
	for _, x in { -2.2, 2.2 } do
		Build.part(m, ground * CFrame.new(x, 1.6, 0), Vector3.new(0.4, 2.9, 3.5), gold, Enum.Material.Metal)
	end
	local lid = Build.cylinder(m, ground * CFrame.new(0, 3.0, 0.9) * CFrame.Angles(math.rad(-35), 0, 0) * CFrame.Angles(0, 0, math.rad(90)), 5, 3.4, WOOD, Enum.Material.WoodPlanks)
	for i = 1, 9 do
		Build.cylinder(m, ground * CFrame.new(jitter(-1.8, 1.8), 3.0 + jitter(0, 0.6), jitter(-1.1, 0.8)) * CFrame.Angles(jitter(-0.5, 0.5), 0, jitter(-0.5, 0.5)), 0.2, 0.9, gold, Enum.Material.Metal)
		local _ = i
	end
	Build.ellipsoid(m, ground * CFrame.new(0, 3.0, -0.2), Vector3.new(3.8, 1.2, 2.4), gold, Enum.Material.Metal)
	Build.light(box, gold, 10, 1)
	return m, lid
end

----------------------------------------------------------------------
-- Ingredient plants (one look per ingredient style)
----------------------------------------------------------------------
function Props.Plant(parent: Instance, ground: CFrame, style: string, color: Color3, tier: number): (Model, BasePart)
	local m = Build.model("Plant", parent)
	local stemColor = Color3.fromRGB(70, 140, 60)
	local focus: BasePart
	local noCollide = { CanCollide = false }

	if style == "Flower" then
		Build.cylinder(m, ground * CFrame.new(0, 1.2, 0), 2.4, 0.25, stemColor, nil, noCollide)
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			Build.ellipsoid(m, ground * CFrame.new(math.cos(a) * 0.75, 2.5, math.sin(a) * 0.75) * CFrame.Angles(0, -a, 0), Vector3.new(1.2, 0.25, 0.7), color, nil, noCollide)
		end
		focus = Build.ellipsoid(m, ground * CFrame.new(0, 2.6, 0), Vector3.new(0.8, 0.4, 0.8), Color3.fromRGB(180, 110, 40), nil, noCollide)
		for _, side in { -1, 1 } do
			Build.ellipsoid(m, ground * CFrame.new(side * 0.5, 0.9, 0) * CFrame.Angles(0, 0, side * math.rad(-30)), Vector3.new(1, 0.2, 0.5), stemColor, Enum.Material.Grass, noCollide)
		end
	elseif style == "Leaf" then
		for i = 1, 5 do
			local a = i / 5 * math.pi * 2
			Build.ellipsoid(m, ground * CFrame.Angles(0, a, 0) * CFrame.new(0.8, 0.9, 0) * CFrame.Angles(0, 0, math.rad(35)), Vector3.new(2.2, 0.25, 1.1), color, Enum.Material.Grass, noCollide)
		end
		focus = Build.ellipsoid(m, ground * CFrame.new(0, 1.5, 0), Vector3.new(0.6, 0.6, 0.6), Color3.fromRGB(190, 240, 255), Enum.Material.Glass, noCollide)
	elseif style == "Root" then
		focus = Build.ellipsoid(m, ground * CFrame.new(0, 0.6, 0), Vector3.new(1.6, 1.4, 1.6), color, nil, noCollide)
		for i = 1, 4 do
			local a = i / 4 * math.pi * 2
			Build.ellipsoid(m, ground * CFrame.new(math.cos(a) * 0.3, 1.8, math.sin(a) * 0.3) * CFrame.Angles(math.cos(a) * 0.4, 0, math.sin(a) * 0.4), Vector3.new(0.3, 1.8, 0.6), stemColor, Enum.Material.Grass, noCollide)
		end
	elseif style == "Pepper" then
		Build.ellipsoid(m, ground * CFrame.new(0, 1, 0), Vector3.new(2.6, 1.6, 2.6), Color3.fromRGB(60, 110, 50), Enum.Material.Grass, noCollide)
		for i = 1, 3 do
			local a = i / 3 * math.pi * 2
			local p = Build.ellipsoid(m, ground * CFrame.new(math.cos(a) * 0.9, 1.2, math.sin(a) * 0.9), Vector3.new(0.5, 1.2, 0.5), color, Enum.Material.Neon, noCollide)
			if i == 1 then
				focus = p
			end
		end
	elseif style == "Mushroom" then
		Build.cylinder(m, ground * CFrame.new(0, 0.8, 0), 1.6, 0.6, Color3.fromRGB(235, 225, 210), nil, noCollide)
		focus = Build.ellipsoid(m, ground * CFrame.new(0, 1.7, 0), Vector3.new(2.2, 1.1, 2.2), color, nil, noCollide)
		for i = 1, 4 do
			local a = i / 4 * math.pi * 2
			Build.ellipsoid(m, ground * CFrame.new(math.cos(a) * 0.6, 2.05, math.sin(a) * 0.6), Vector3.new(0.35, 0.2, 0.35), Color3.new(1, 1, 1), nil, noCollide)
		end
		Build.cylinder(m, ground * CFrame.new(1, 0.4, 0.4), 0.8, 0.35, Color3.fromRGB(235, 225, 210), nil, noCollide)
		Build.ellipsoid(m, ground * CFrame.new(1, 0.9, 0.4), Vector3.new(1, 0.5, 1), color, nil, noCollide)
	elseif style == "Berry" then
		Build.ellipsoid(m, ground * CFrame.new(0, 1.1, 0), Vector3.new(3, 2.2, 3), Color3.fromRGB(50, 90, 80), Enum.Material.Grass, noCollide)
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			local b = Build.ellipsoid(m, ground * CFrame.new(math.cos(a) * 1.3, 1.3 + (i % 2) * 0.5, math.sin(a) * 1.3), Vector3.new(0.55, 0.55, 0.55), color, Enum.Material.Neon, noCollide)
			if i == 1 then
				focus = b
			end
		end
	else -- Nectar: a glowing crystal flower
		Build.cylinder(m, ground * CFrame.new(0, 1.4, 0), 2.8, 0.25, Color3.fromRGB(200, 230, 255), Enum.Material.Glass, noCollide)
		for i = 1, 5 do
			local a = i / 5 * math.pi * 2
			Build.ellipsoid(m, ground * CFrame.new(math.cos(a) * 0.6, 3.0, math.sin(a) * 0.6) * CFrame.Angles(math.sin(a) * 0.6, 0, -math.cos(a) * 0.6), Vector3.new(0.5, 1.6, 0.5), Color3.fromRGB(255, 230, 255), Enum.Material.Glass, noCollide)
		end
		focus = Build.ellipsoid(m, ground * CFrame.new(0, 3.1, 0), Vector3.new(0.8, 0.8, 0.8), color, Enum.Material.Neon, noCollide)
	end

	Build.light(focus, color, 6 + tier * 2, 0.8)
	local sparkle = Build.sparkles(focus, color, tier * 2, 0.3)
	sparkle.Name = "Sparkle"
	m.PrimaryPart = focus
	return m, focus
end

return Props
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- Builds the whole map out of parts at server start, so the place runs with
-- no uploaded assets. Replace any of it with hand-built models later.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Build = require(script.Parent.Build)
local Props = require(script.Parent.Props)

local WorldBuilder = {}

WorldBuilder.Hazards = {} :: { { Position: Vector3, Radius: number, Zone: string, Name: string, Part: BasePart } }
WorldBuilder.IngredientNodes = {} :: { Model }
WorldBuilder.Folder = nil :: Folder?
WorldBuilder.ShopPrompt = nil :: ProximityPrompt?
WorldBuilder.PublicBrew = nil :: BasePart? -- the big hub cauldron anyone can brew at
WorldBuilder.PublicBrewPrompt = nil :: ProximityPrompt?

local rng = Random.new(20261011)

local GRASS = Color3.fromRGB(116, 178, 92)
local COBBLE = Color3.fromRGB(196, 186, 168)
local COBBLE_DARK = Color3.fromRGB(160, 150, 136)
local PATH = Color3.fromRGB(205, 180, 135)

-- Generic part helper kept for the telegraph effects in GuardianService.
-- props.ClassName picks the class (defaults to Part).
local function part(props): Part
	local p = Instance.new(props.ClassName or "Part") :: Part
	props.ClassName = nil
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end
WorldBuilder.Part = part

-- Flat disc centred on `center` (cylinder lying on its side).
local function disc(name, center: Vector3, radius: number, height: number, color: Color3, material, parent)
	return part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = parent,
	})
end
WorldBuilder.Disc = disc

local function prompt(parent: Instance, action: string, object: string, distance: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.MaxActivationDistance = distance or 12
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end
WorldBuilder.Prompt = prompt

local function polar(angleDeg: number, radius: number): Vector3
	local a = math.rad(angleDeg)
	return Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
end

-- Ground frame at `pos` facing toward `lookAt` (front = -Z).
local function facing(pos: Vector3, lookAt: Vector3): CFrame
	return CFrame.lookAt(pos, Vector3.new(lookAt.X, pos.Y, lookAt.Z))
end

-- Random point in a disc that keeps clear of the given points.
local function scatter(center: Vector3, radius: number, avoid: { Vector3 }, minGap: number): Vector3
	local best = center
	for _ = 1, 50 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * radius
		local candidate = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		local ok = true
		for _, p in avoid do
			if (p - candidate).Magnitude < minGap then
				ok = false
				break
			end
		end
		best = candidate
		if ok then
			break
		end
	end
	return best
end

----------------------------------------------------------------------
-- Zones
----------------------------------------------------------------------
local ZONE_STYLE = {
	Meadow = { Floor = Enum.Material.Grass, Tree = "Round", Tree2 = "Pine", Rock = Color3.fromRGB(150, 150, 140), Accent = Color3.fromRGB(140, 230, 110) },
	Caldera = { Floor = Enum.Material.Slate, Tree = "Dead", Tree2 = "Dead", Rock = Color3.fromRGB(60, 48, 46), Accent = Color3.fromRGB(255, 120, 40) },
	Frost = { Floor = Enum.Material.Snow, Tree = "SnowPine", Tree2 = "SnowPine", Rock = Color3.fromRGB(190, 210, 225), Accent = Color3.fromRGB(150, 210, 255) },
}

local function buildHazard(zoneId: string, zone, position: Vector3, parent: Instance)
	local r = Config.HazardRadius
	local m = Build.model(zone.HazardName, parent)
	local ground = CFrame.new(position)
	local base: BasePart

	if zoneId == "Caldera" then
		base = Build.cylinder(m, ground * CFrame.new(0, 0.25, 0), 0.3, r * 1.6, Color3.fromRGB(255, 110, 30), Enum.Material.Neon, { CanCollide = false })
		Build.cylinder(m, ground * CFrame.new(0, 0.32, 0), 0.3, r * 0.9, Color3.fromRGB(255, 210, 90), Enum.Material.Neon, { CanCollide = false })
		for i = 1, 10 do
			local a = i / 10 * math.pi * 2
			Props.Rocks(m, ground * CFrame.new(math.cos(a) * r * 0.95, 0, math.sin(a) * r * 0.95), rng:NextNumber(2.4, 3.6), Color3.fromRGB(45, 36, 34), Enum.Material.Basalt)
		end
		local fire = Instance.new("Fire")
		fire.Size = 10
		fire.Heat = 14
		fire.Parent = base
		local smoke = Instance.new("Smoke")
		smoke.Color = Color3.fromRGB(70, 60, 60)
		smoke.Opacity = 0.15
		smoke.RiseVelocity = 6
		smoke.Size = 6
		smoke.Parent = base
		Build.light(base, Color3.fromRGB(255, 120, 40), 22, 2)
	elseif zoneId == "Frost" then
		base = Build.cylinder(m, ground * CFrame.new(0, 0.22, 0), 0.25, r * 2, Color3.fromRGB(175, 225, 255), Enum.Material.Ice, { CanCollide = false })
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			local d = if i == 1 then 0 else r * 0.55
			Props.Crystals(m, ground * CFrame.new(math.cos(a) * d, 0, math.sin(a) * d), rng:NextNumber(3, 4.5), Color3.fromRGB(170, 225, 255), false)
		end
	else
		base = Build.cylinder(m, ground * CFrame.new(0, 0.22, 0), 0.25, r * 2, Color3.fromRGB(70, 90, 45), Enum.Material.Grass, { CanCollide = false })
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2 + rng:NextNumber(0, 0.5)
			local d = if i == 1 then 0 else r * rng:NextNumber(0.4, 0.7)
			local s = rng:NextNumber(3.5, 5.5)
			local bush = CFrame.new(position + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d))
			Build.ellipsoid(m, bush * CFrame.new(0, s * 0.35, 0), Vector3.new(s, s * 0.7, s), Color3.fromRGB(46, 74, 40), Enum.Material.Grass, { CanCollide = false })
			for k = 1, 5 do
				local ta = k / 5 * math.pi * 2
				Build.spike(m, bush * CFrame.new(math.cos(ta) * s * 0.4, s * 0.35, math.sin(ta) * s * 0.4) * CFrame.Angles(math.sin(ta) * 1.2, 0, -math.cos(ta) * 1.2), 1.4, 0.4, Color3.fromRGB(150, 40, 50), nil, { CanCollide = false })
			end
		end
	end

	base.Name = "HazardBase"
	base:SetAttribute("Hazard", true)
	base:SetAttribute("Zone", zoneId)
	table.insert(WorldBuilder.Hazards, {
		Position = position,
		Radius = r,
		Zone = zoneId,
		Name = zone.HazardName,
		Part = base,
	})
end

local function buildIngredientNode(ingredientId: string, position: Vector3, parent: Instance)
	local def = Config.Ingredients[ingredientId]
	local m, focus = Props.Plant(parent, CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), def.Style or "Flower", def.Color, def.Tier)
	m:ScaleTo(1.6)
	Build.sitOnGround(m, position.Y)
	m.Name = "Node_" .. ingredientId
	m:SetAttribute("IngredientId", ingredientId)
	local p = prompt(focus, "Harvest", def.Name, 10)
	p.Name = "HarvestPrompt"
	p.HoldDuration = 0.3 + def.Tier * 0.25
	table.insert(WorldBuilder.IngredientNodes, m)
end

local function buildZone(zoneId: string, folder: Folder)
	local zone = Config.Zones[zoneId]
	local style = ZONE_STYLE[zoneId]
	local center = Config.ZoneCenter(zoneId)
	local zoneFolder = Instance.new("Folder")
	zoneFolder.Name = zoneId
	zoneFolder.Parent = folder

	local inward = (Vector3.zero - center).Unit
	Build.cylinder(zoneFolder, CFrame.new(center + Vector3.new(0, 0.1, 0)), 0.3, (zone.Radius + 12) * 2, zone.Floor, style.Floor)
	Build.cylinder(zoneFolder, CFrame.new(center + Vector3.new(0, 0.05, 0)), 0.3, (zone.Radius + 18) * 2, zone.Floor:Lerp(GRASS, 0.5), style.Floor)

	-- Gate where the path arrives
	local gatePos = center + inward * (zone.Radius + 10)
	Props.Gate(zoneFolder, facing(gatePos + Vector3.new(0, 0.2, 0), Vector3.zero), 20, zone.Name, style.Accent)

	-- Dense border so the zone reads as a place
	for i = 1, 80 do
		local a = (i / 80) * math.pi * 2 + rng:NextNumber(-0.04, 0.04)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		if dir:Dot(inward) < 0.95 then
			local pos = center + dir * (zone.Radius + (if i % 2 == 0 then rng:NextNumber(2, 9) else rng:NextNumber(11, 22)))
			local ground = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
			local roll = rng:NextNumber()
			if roll < 0.55 then
				Props.Tree(zoneFolder, ground, if roll < 0.3 then style.Tree else style.Tree2)
			elseif zoneId == "Frost" and roll < 0.8 then
				Props.Crystals(zoneFolder, ground, rng:NextNumber(4, 7), Color3.fromRGB(170, 220, 255), rng:NextNumber() < 0.3)
			else
				Props.Rocks(zoneFolder, ground, rng:NextNumber(4, 8), style.Rock)
			end
		end
	end

	local taken = { gatePos }
	local hazardFolder = Instance.new("Folder")
	hazardFolder.Name = "Hazards"
	hazardFolder.Parent = zoneFolder
	for _ = 1, zone.Hazards do
		local pos = scatter(center, zone.Radius - 16, taken, 30)
		table.insert(taken, pos)
		buildHazard(zoneId, zone, pos, hazardFolder)
	end

	local nodeFolder = Instance.new("Folder")
	nodeFolder.Name = "Ingredients"
	nodeFolder.Parent = zoneFolder
	for _, ingredientId in Config.IngredientOrder do
		local count = Config.Ingredients[ingredientId].Zones[zoneId]
		for _ = 1, count or 0 do
			local pos = scatter(center, zone.Radius - 6, taken, 14)
			table.insert(taken, pos)
			buildIngredientNode(ingredientId, pos, nodeFolder)
		end
	end

	-- Floor colour variation
	for _ = 1, 14 do
		local pos = scatter(center, zone.Radius - 10, {}, 0)
		local sz = rng:NextNumber(18, 40)
		Build.ellipsoid(zoneFolder, CFrame.new(pos + Vector3.new(0, 0.26, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Vector3.new(sz, 0.08, sz * 0.7), zone.Floor:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0.05, 0.15)), style.Floor, { CanCollide = false })
	end

	-- Inner scenery, kept clear of hazards, plants and each other
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = zoneFolder
	for i = 1, 28 do
		local pos = scatter(center, zone.Radius - 8, taken, 15)
		table.insert(taken, pos)
		local ground = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
		local roll = i % 4
		if zoneId == "Meadow" then
			if roll == 0 then
				Props.Tree(decor, ground, "Round")
			elseif roll == 1 then
				Props.FlowerPatch(decor, ground, 5)
			elseif roll == 2 then
				Props.Rocks(decor, ground, rng:NextNumber(2.5, 4.5), style.Rock)
			else
				-- fallen log with mushrooms
				Build.cylinder(decor, ground * CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(90), 0, 0), 9, 2, Color3.fromRGB(110, 78, 52), Enum.Material.Wood)
				Build.ellipsoid(decor, ground * CFrame.new(0.9, 2, 2), Vector3.new(1.4, 0.6, 1.4), Color3.fromRGB(220, 70, 60))
			end
		elseif zoneId == "Caldera" then
			if roll == 0 then
				-- tapering basalt spire with a glowing seam
				local h = rng:NextNumber(5, 9)
				local tilt = CFrame.Angles(rng:NextNumber(-0.15, 0.15), rng:NextNumber(0, 6), rng:NextNumber(-0.15, 0.15))
				for k = 0, 2 do
					local w = 5 - k * 1.4
					Build.part(decor, ground * tilt * CFrame.new(0, h * k * 0.8 + h * 0.45, 0) * CFrame.Angles(0, k * 0.5, 0), Vector3.new(w, h, w), Color3.fromRGB(48, 40, 40), Enum.Material.Basalt)
				end
				Build.part(decor, ground * tilt * CFrame.new(0, h * 0.9, 0), Vector3.new(5.2, 0.3, 5.2), Color3.fromRGB(255, 110, 30), Enum.Material.Neon)
			elseif roll == 1 then
				-- glowing crack in the ground
				Build.part(decor, ground * CFrame.new(0, 0.28, 0), Vector3.new(1, 0.1, rng:NextNumber(12, 22)), Color3.fromRGB(255, 120, 40), Enum.Material.Neon, { CanCollide = false })
			elseif roll == 2 then
				Props.Tree(decor, ground, "Dead")
			else
				Props.Rocks(decor, ground, rng:NextNumber(3, 6), style.Rock, Enum.Material.Basalt)
			end
		else
			if roll == 0 then
				Props.Tree(decor, ground, "SnowPine")
			elseif roll == 1 then
				Build.ellipsoid(decor, ground * CFrame.new(0, 0.6, 0), Vector3.new(rng:NextNumber(8, 14), 2.4, rng:NextNumber(6, 10)), Color3.fromRGB(245, 250, 255), Enum.Material.Snow, { CanCollide = false })
			elseif roll == 2 then
				Props.Crystals(decor, ground, rng:NextNumber(2.5, 4), Color3.fromRGB(190, 230, 255), true)
			else
				Build.cylinder(decor, ground * CFrame.new(0, 0.3, 0), 0.1, rng:NextNumber(10, 16), Color3.fromRGB(160, 215, 245), Enum.Material.Ice, { CanCollide = false })
			end
		end
	end
end

----------------------------------------------------------------------
-- Paths
----------------------------------------------------------------------
local function buildPath(from: Vector3, to: Vector3, width: number, folder: Instance)
	local dir = (to - from)
	local length = dir.Magnitude
	local mid = (from + to) / 2
	local cf = CFrame.lookAt(mid, mid + dir.Unit)
	Build.part(folder, cf * CFrame.new(0, 0.12, 0), Vector3.new(width, 0.25, length), PATH, Enum.Material.Pebble)
	-- edge stones
	local count = math.floor(length / 7)
	for i = 0, count do
		for _, side in { -1, 1 } do
			local z = -length / 2 + (i / math.max(count, 1)) * length
			Build.part(folder, cf * CFrame.new(side * (width / 2 + 0.5), 0.35, z) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), 0), Vector3.new(1.4, 0.7, 2.2), COBBLE_DARK, Enum.Material.Slate)
		end
	end
end

----------------------------------------------------------------------
-- Hub
----------------------------------------------------------------------
local function buildHub(folder: Folder)
	local hub = Instance.new("Folder")
	hub.Name = "Hub"
	hub.Parent = folder
	local R = Config.HubRadius

	-- Plaza rings
	Build.cylinder(hub, CFrame.new(0, 0.15, 0), 0.3, R * 2, COBBLE, Enum.Material.Cobblestone)
	Build.ring(hub, CFrame.new(0, 0.3, 0), R - 1, 1.2, 64, COBBLE_DARK, Enum.Material.Slate)
	Build.cylinder(hub, CFrame.new(0, 0.2, 0), 0.3, 64, COBBLE_DARK, Enum.Material.Cobblestone)
	Build.ring(hub, CFrame.new(0, 0.35, 0), 32, 0.8, 48, Color3.fromRGB(150, 110, 230), Enum.Material.Neon)

	for i = 0, 7 do
		local a = i * 45
		local mid = polar(a, (R + 32) / 2)
		Build.part(hub, CFrame.lookAt(mid + Vector3.new(0, 0.32, 0), Vector3.new(0, 0.32, 0)), Vector3.new(6, 0.05, R - 32), COBBLE_DARK, Enum.Material.Slate)
		-- planter with a tree between the stripes
		local planter = polar(a + 22.5, 70)
		Build.cylinder(hub, CFrame.new(planter + Vector3.new(0, 0.8, 0)), 1.6, 8, COBBLE_DARK, Enum.Material.Slate)
		Props.Tree(hub, CFrame.new(planter + Vector3.new(0, 1.6, 0)), "Round")
	end

	-- Dais with the giant public cauldron
	for i, rad in { 22, 17, 12.5 } do
		Build.cylinder(hub, CFrame.new(0, 0.3 + i * 0.9 - 0.45, 0), 0.9, rad * 2, if i % 2 == 0 then COBBLE else COBBLE_DARK, Enum.Material.Slate)
	end
	local _, brew, belly = Props.Cauldron(hub, CFrame.new(0, 2.95, 0), 6, Color3.fromRGB(170, 110, 255))
	WorldBuilder.PublicBrew = brew
	WorldBuilder.PublicBrewPrompt = prompt(belly, "Brew", "Public Cauldron", 16)

	-- Lanterns, benches and flower beds around the plaza
	for i = 0, 7 do
		local a = i * 45 + 22.5
		Props.Lantern(hub, facing(polar(a, R - 8), Vector3.zero) * CFrame.Angles(0, math.pi, 0), 10)
		if i % 2 == 0 then
			Props.Bench(hub, facing(polar(a + 22.5, 42), Vector3.zero))
		else
			local bed = polar(a + 22.5, 44)
			Build.cylinder(hub, CFrame.new(bed + Vector3.new(0, 0.6, 0)), 1.2, 9, COBBLE_DARK, Enum.Material.Slate)
			Build.cylinder(hub, CFrame.new(bed + Vector3.new(0, 1.0, 0)), 0.6, 8, Color3.fromRGB(90, 62, 44), Enum.Material.Ground)
			Props.FlowerPatch(hub, CFrame.new(bed + Vector3.new(0, 1.3, 0)), 3)
		end
	end

	-- Shop stall, clear of the zone paths
	local stallPos = polar(210, 62) + Vector3.new(0, 0.3, 0)
	local _, counter = Props.Stall(hub, facing(stallPos, Vector3.zero), Color3.fromRGB(230, 80, 100), Color3.fromRGB(255, 240, 230))
	WorldBuilder.ShopPrompt = prompt(counter, "Shop", "Vials & Cauldrons", 12)
	Props.SignBoard(hub, facing(stallPos, Vector3.zero) * CFrame.new(11, 0, -2), "SHOP", 8, Color3.fromRGB(150, 60, 80))

	-- Spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 0.4, 8)
	spawn.CFrame = CFrame.new(0, 0.5, 40)
	spawn.Color = Color3.fromRGB(170, 130, 255)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.5
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = hub
end

function WorldBuilder.Build()
	local folder = Instance.new("Folder")
	folder.Name = "World"
	folder.Parent = workspace
	WorldBuilder.Folder = folder

	local ground = Build.part(folder, CFrame.new(0, -2, 0), Vector3.new(2048, 4, 2048), GRASS, Enum.Material.Grass)
	ground.Name = "Ground"
	ground.Locked = true

	-- Soft colour patches and tufts so the grass isn't one flat colour
	for _ = 1, 40 do
		local p = Vector3.new(rng:NextNumber(-650, 650), 0.02, rng:NextNumber(-650, 650))
		if p.Magnitude > Config.HubRadius + 10 then
			local s = rng:NextNumber(30, 90)
			Build.ellipsoid(folder, CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Vector3.new(s, 0.1, s * 0.7), GRASS:Lerp(Color3.fromRGB(80, 140, 70), rng:NextNumber(0.2, 0.6)), Enum.Material.Grass, { CanCollide = false })
		end
	end
	local tufts = Instance.new("Folder")
	tufts.Name = "Tufts"
	tufts.Parent = folder
	for _ = 1, 160 do
		local p = Vector3.new(rng:NextNumber(-600, 600), 0, rng:NextNumber(-600, 600))
		if p.Magnitude > Config.HubRadius + 5 then
			Props.GrassTuft(tufts, CFrame.new(p), GRASS:Lerp(Color3.fromRGB(60, 120, 50), rng:NextNumber(0, 0.5)))
		end
	end

	buildHub(folder)

	local paths = Instance.new("Folder")
	paths.Name = "Paths"
	paths.Parent = folder
	for _, zoneId in Config.ZoneOrder do
		local zone = Config.Zones[zoneId]
		local dir = polar(zone.Angle, 1)
		buildPath(dir * (Config.HubRadius - 2), dir * (zone.Distance - zone.Radius - 10), 16, paths)
		-- Gate where the path leaves the hub
		Props.Gate(folder, facing(dir * (Config.HubRadius + 4) + Vector3.new(0, 0.1, 0), dir * 1000), 20, "→ " .. zone.Name, ZONE_STYLE[zoneId].Accent)
		buildZone(zoneId, folder)
	end
	for i = 1, Config.PlotCount do
		local center = Config.PlotCenter(i)
		local dir = center.Unit
		buildPath(dir * (Config.HubRadius - 2), dir * (Config.PlotRadius - Config.PlotSize / 2), 10, paths)
	end

	return folder
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="17">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="19">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Brew Guardians client entry point.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local CaptureFX = require(script.CaptureFX)
local Hud = require(script.Hud)
local Menus = require(script.Menus)
local State = require(script.State)
local Targeting = require(script.Targeting)
local UI = require(script.UI)

UI.OnClick = function()
	Hud.PlaySound("Click")
end
Hud.Init()

if Config.Sounds.Music ~= "" then
	local music = Instance.new("Sound")
	music.Name = "Music"
	music.SoundId = Config.Sounds.Music
	music.Looped = true
	music.Volume = 0.3
	music.Parent = workspace
	music:Play()
end

Menus.Init()
CaptureFX.Init()
Hud.OpenMenu = Menus.Open

Remotes.StateUpdate.OnClientEvent:Connect(State.Set)
Remotes.Notify.OnClientEvent:Connect(Hud.Toast)
Remotes.Announce.OnClientEvent:Connect(Hud.Announce)
Remotes.OpenUI.OnClientEvent:Connect(Menus.Open)
Remotes.RequestState:FireServer()

task.spawn(Targeting.Init)

-- First-time players get the how-to-play page.
task.delay(2, function()
	local data = State.Data
	if data and data.Stats.Throws == 0 then
		Menus.Open("Help")
	end
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">CaptureFX</string>
            <string name="Source"><![CDATA[-- The throw arc and the shake moment. The server decides the outcome up
-- front and sends how many shakes pass; this plays it back with rising
-- tension: each shake wobbles harder, sounds higher and fills one more dot,
-- then the flask either locks with a flash or shatters.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Hud = require(script.Parent.Hud)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local CaptureFX = {}

local fxFolder: Folder

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function sound(id: string, parent: Instance, speed: number?, volume: number?)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.PlaybackSpeed = speed or 1
	s.Volume = volume or 0.7
	s.RollOffMaxDistance = 150
	s.Parent = parent
	s:Play()
	Debris:AddItem(s, 4)
end

local function newPart(props): Part
	local p = Instance.new(props.ClassName or "Part") :: Part
	props.ClassName = nil
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = props.Parent or fxFolder
	return p
end

local function sparkles(parent: Instance, color: Color3, amount: number, speed: number)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new(0.6, 0)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.Lifetime = NumberRange.new(0.5, 1)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rate = 0
	e.LightEmission = 1
	e.Parent = parent
	e:Emit(amount)
	Debris:AddItem(e, 2)
end

local function ring(position: Vector3, color: Color3, size: number)
	local p = newPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 1, 1),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.2,
	})
	local t = TweenService:Create(p, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.2, size, size),
		Transparency = 1,
	})
	t:Play()
	Debris:AddItem(p, 0.5)
end

local function cameraShake(intensity: number, duration: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	task.spawn(function()
		local t = 0
		while t < duration do
			local fade = 1 - t / duration
			humanoid.CameraOffset = Vector3.new(
				(math.random() - 0.5) * intensity * fade,
				(math.random() - 0.5) * intensity * fade,
				0
			)
			t += RunService.RenderStepped:Wait()
		end
		humanoid.CameraOffset = Vector3.zero
	end)
end

-- A little flask: round body, neck and cork.
local function buildFlask(color: Color3, scale: number): Model
	local model = Instance.new("Model")
	model.Name = "Flask"
	local bodyPart = newPart({
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2 * scale,
		Color = color,
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		Parent = model,
	})
	newPart({
		Name = "Core",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.3 * scale,
		Color = color,
		Material = Enum.Material.Neon,
		Parent = model,
	})
	newPart({
		Name = "Neck",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.9 * scale, 0.7 * scale, 0.7 * scale),
		CFrame = CFrame.new(0, 1.2 * scale, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		Parent = model,
	})
	newPart({
		Name = "Cork",
		Size = Vector3.new(0.6, 0.4, 0.6) * scale,
		CFrame = CFrame.new(0, 1.75 * scale, 0),
		Color = Color3.fromRGB(150, 105, 60),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10
	light.Brightness = 2
	light.Parent = bodyPart
	model.PrimaryPart = bodyPart
	model.Parent = fxFolder
	return model
end

-- Pivot a flask so the bottom of the body touches `ground`, tilted by `tilt`.
-- Rocks around the bottom of the flask, not its centre.
local function placeFlask(flask: Model, ground: Vector3, tilt: number, scale: number)
	flask:PivotTo(CFrame.new(ground) * CFrame.Angles(0, 0, tilt) * CFrame.new(0, scale, 0))
end

local function flaskColor(flaskId: string): Color3
	local f = Config.GetFlask(flaskId)
	return f and f.Color or Color3.new(1, 1, 1)
end

----------------------------------------------------------------------
-- Throw arc
----------------------------------------------------------------------
local function onThrowVisual(from: Vector3, target: Instance?, color: Color3, flight: number)
	if typeof(target) ~= "Instance" or not target:IsA("Model") then
		return
	end
	local model = target :: Model
	local flask = buildFlask(color, 0.6)
	sound(Config.Sounds.Throw, flask.PrimaryPart :: BasePart, 1.1, 0.6)
	local trail = Instance.new("Trail")
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.4, 0)
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.4, 0)
	a0.Parent = flask.PrimaryPart
	a1.Parent = flask.PrimaryPart
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.3
	trail.LightEmission = 1
	trail.Parent = flask.PrimaryPart

	local t = 0
	local last = model:GetPivot().Position
	while t < flight do
		t += RunService.RenderStepped:Wait()
		local alpha = math.min(t / flight, 1)
		if model.Parent then
			last = model:GetPivot().Position
		end
		local height = math.max((from - last).Magnitude * 0.25, 4)
		local pos = from:Lerp(last, alpha) + Vector3.new(0, math.sin(alpha * math.pi) * height, 0)
		flask:PivotTo(CFrame.new(pos) * CFrame.Angles(alpha * 12, alpha * 6, 0))
	end
	flask:Destroy()
end

----------------------------------------------------------------------
-- The shake sequence
----------------------------------------------------------------------
local function dotsGui(adornee: BasePart): (BillboardGui, { Frame })
	local gui = UI.make("BillboardGui", {
		Adornee = adornee,
		Size = UDim2.fromOffset(150, 44),
		StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0),
		AlwaysOnTop = true,
		MaxDistance = 160,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local holder = UI.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local layout = UI.list(holder, 10, true)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	local dots = {}
	for i = 1, CatchMath.Shakes do
		table.insert(dots, UI.make("Frame", {
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = Color3.fromRGB(40, 35, 55),
			Corner = 14,
			Stroke = Color3.new(1, 1, 1),
			LayoutOrder = i,
			Parent = holder,
		}))
	end
	return gui, dots
end

local function wobble(flask: Model, ground: Vector3, scale: number, amplitude: number, duration: number)
	-- Three half-swings that settle back to upright.
	local t = 0
	while t < duration do
		t += RunService.RenderStepped:Wait()
		local alpha = math.min(t / duration, 1)
		local tilt = math.sin(alpha * math.pi * 3) * amplitude * (1 - alpha * 0.4)
		placeFlask(flask, ground, tilt, scale)
	end
	placeFlask(flask, ground, 0, scale)
end

local function shatter(flask: Model, color: Color3)
	local center = flask:GetPivot().Position
	for _, part in flask:GetDescendants() do
		if part:IsA("BasePart") then
			part:Destroy()
		end
	end
	for _ = 1, 10 do
		local shard = newPart({
			ClassName = "WedgePart",
			Size = Vector3.new(0.2, math.random() * 0.6 + 0.3, math.random() * 0.6 + 0.3),
			CFrame = CFrame.new(center) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6),
			Color = color,
			Material = Enum.Material.Glass,
			Transparency = 0.2,
		})
		shard.Anchored = false
		shard.CanCollide = true
		shard.AssemblyLinearVelocity = Vector3.new(math.random(-25, 25), math.random(15, 35), math.random(-25, 25))
		shard.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
		Debris:AddItem(shard, 2.5)
	end
end

local function onCaptureSequence(info)
	local ground: Vector3 = info.Position
	local shakes: number = info.Shakes
	local isMine = info.ThrowerUserId == player.UserId
	local def = Config.Guardians[info.GuardianId]
	local color = flaskColor(info.FlaskId)
	local accent = def and def.Accent or Color3.new(1, 1, 1)
	local scale = 1.1

	-- Only the thrower and people nearby need the full show.
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not isMine and (not root or (root.Position - ground).Magnitude > 200) then
		return
	end

	local flask = buildFlask(color, scale)
	local body = flask.PrimaryPart :: BasePart

	-- 1) Swallow: a bright sphere the size of the guardian collapses into the flask.
	local size = def and def.Size * 1.3 or 5
	local orb = newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size,
		CFrame = CFrame.new(ground + Vector3.new(0, size / 2, 0)),
		Color = accent,
		Material = Enum.Material.Neon,
		Transparency = 0.1,
	})
	TweenService:Create(orb, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = Vector3.one * 0.5,
		CFrame = CFrame.new(ground + Vector3.new(0, scale, 0)),
		Transparency = 0.6,
	}):Play()
	Debris:AddItem(orb, 0.4)

	-- Flask drops in with a little bounce.
	local dropStart = os.clock()
	while os.clock() - dropStart < 0.3 do
		local a = (os.clock() - dropStart) / 0.3
		local bounce = math.abs(math.sin(a * math.pi * 1.5)) * (1 - a) * 3
		flask:PivotTo(CFrame.new(ground + Vector3.new(0, scale + bounce + (1 - a) * 4, 0)))
		RunService.RenderStepped:Wait()
	end
	placeFlask(flask, ground, 0, scale)
	ring(ground + Vector3.new(0, 0.3, 0), color, 10)
	sparkles(body, accent, 25, 10)
	if isMine then
		cameraShake(0.4, 0.2)
	end

	local gui, dots = dotsGui(body)
	task.wait(math.max(CatchMath.LandTime - 0.3, 0))

	-- 2) Shakes. A burst happens partway through shake number shakes + 1.
	for i = 1, CatchMath.Shakes do
		local amplitude = math.rad(14 + i * 9)
		local pitch = 0.9 + i * 0.18
		sound(Config.Sounds.Shake, body, pitch, 0.6 + i * 0.15)
		if i > shakes then
			-- Breaking free: a violent half-wobble, then glass everywhere.
			wobble(flask, ground, scale, amplitude * 1.6, CatchMath.ShakeInterval * 0.35)
			local nearMiss = i == CatchMath.Shakes
			dots[i].BackgroundColor3 = Color3.fromRGB(255, 70, 70)
			sound(Config.Sounds.Burst, body, 0.8, 1)
			ring(ground + Vector3.new(0, 0.5, 0), Color3.fromRGB(255, 80, 60), 18)
			shatter(flask, color)
			local burstAnchor = newPart({ Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(ground + Vector3.new(0, 2, 0)) })
			sparkles(burstAnchor, Color3.fromRGB(255, 90, 70), 50, 25)
			Debris:AddItem(burstAnchor, 2)
			if isMine then
				cameraShake(if nearMiss then 1.6 else 1, 0.45)
				Hud.Flash(Color3.fromRGB(255, 60, 60), if nearMiss then 0.45 else 0.3)
				Hud.BigText(if nearMiss then "SO CLOSE!" else "It broke free!", Color3.fromRGB(255, 110, 90))
			end
			task.wait(0.6)
			gui:Destroy()
			flask:Destroy()
			return
		end

		wobble(flask, ground, scale, amplitude, CatchMath.ShakeInterval * 0.55)
		-- Shake survived: light up a dot and pulse.
		local dot = dots[i]
		dot.BackgroundColor3 = Color3.fromRGB(255, 220, 90)
		TweenService:Create(dot, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(34, 34) }):Play()
		ring(ground + Vector3.new(0, 0.3, 0), accent, 6 + i * 4)
		sparkles(body, accent, 8 * i, 6 + i * 3)
		if isMine then
			cameraShake(0.25 + i * 0.25, 0.2)
		end
		task.wait(CatchMath.ShakeInterval * 0.45)
	end

	-- 3) Click. Locked.
	sound(Config.Sounds.Lock, body, 1.2, 1)
	for _, d in dots do
		d.BackgroundColor3 = Color3.fromRGB(120, 255, 140)
	end
	ring(ground + Vector3.new(0, 0.5, 0), Color3.fromRGB(255, 240, 150), 24)
	sparkles(body, Color3.fromRGB(255, 230, 120), 80, 22)
	local core = flask:FindFirstChild("Core") :: BasePart?
	if core then
		core.Color = Color3.new(1, 1, 1)
	end
	if isMine then
		Hud.Flash(Color3.new(1, 1, 1), 0.65)
		Hud.BigText("GOTCHA!", Color3.fromRGB(255, 225, 90), 1.8)
		cameraShake(0.6, 0.3)
	end
	task.wait(CatchMath.ResultTime)
	gui:Destroy()

	-- Flask zips off toward the thrower's plot (upwards and away).
	for _, part in flask:GetDescendants() do
		if part:IsA("BasePart") then
			TweenService:Create(part, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
				Size = part.Size * 0.05,
				Position = part.Position + Vector3.new(0, 12, 0),
			}):Play()
		end
	end
	Debris:AddItem(flask, 0.6)
end

----------------------------------------------------------------------
-- Plot guardians idle-bob locally so displays feel alive.
----------------------------------------------------------------------
local function bobPlotGuardians()
	local plots = workspace:WaitForChild("Plots", 30)
	if not plots then
		return
	end
	local base: { [Model]: CFrame } = {}
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for _, plot in plots:GetChildren() do
			local displays = plot:FindFirstChild("Displays")
			if displays then
				for i, model in displays:GetChildren() do
					if model:IsA("Model") and model.PrimaryPart then
						if not base[model] then
							base[model] = model:GetPivot()
							model.Destroying:Once(function()
								base[model] = nil
							end)
						end
						local offset = math.abs(math.sin(t * 2 + i)) * 0.6
						model:PivotTo(base[model] * CFrame.new(0, offset, 0))
					end
				end
			end
		end
	end)
end

function CaptureFX.Init()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "LocalFX"
	fxFolder.Parent = workspace

	Remotes.ThrowVisual.OnClientEvent:Connect(function(...)
		task.spawn(onThrowVisual, ...)
	end)
	Remotes.CaptureSequence.OnClientEvent:Connect(function(info)
		task.spawn(onCaptureSequence, info)
	end)
	task.spawn(bobPlotGuardians)
end

return CaptureFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- Always-on HUD: currency, menu buttons, the hotbar, toasts and banners.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local T = UI.Theme

local Hud = {}
Hud.OpenMenu = nil :: ((name: string) -> ())?

local gui: ScreenGui
local coinsLabel: TextLabel
local vialsLabel: TextLabel
local luckPill: Frame
local luckLabel: TextLabel
local toastHolder: Frame
local hintLabel: TextLabel
local slotButtons: { { Kind: string, Id: string, Button: TextButton, Count: TextLabel, Name: TextLabel, Icon: Frame?, Color: Color3 } } = {}
local feedPicker: Frame

local KIND_COLORS = {
	item = Color3.fromRGB(120, 200, 255),
	coins = T.Gold,
	weaken = Color3.fromRGB(255, 160, 80),
	favorite = T.Pink,
	catch = T.Good,
	nearmiss = Color3.fromRGB(255, 130, 60),
	fail = T.Bad,
	error = T.Bad,
	brew = Color3.fromRGB(150, 255, 170),
	info = Color3.fromRGB(200, 180, 255),
}

----------------------------------------------------------------------
-- Toasts, banners, flashes
----------------------------------------------------------------------
local KIND_SOUNDS = { item = "Harvest", coins = "Coins", brew = "Brew" }

local function playSound(slot: string)
	local id = Config.Sounds[slot]
	if not id or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = 0.6
	s.Parent = gui
	s:Play()
	s.Ended:Once(function()
		s:Destroy()
	end)
end
Hud.PlaySound = playSound

function Hud.Toast(text: string, kind: string?)
	local soundSlot = KIND_SOUNDS[kind or ""]
	if soundSlot then
		playSound(soundSlot)
	end
	local color = KIND_COLORS[kind or "info"] or T.Text
	local toast = UI.panel({
		Size = UDim2.fromOffset(460, 40),
		Color = T.PanelDark,
		Corner = 20,
		BackgroundTransparency = 0.05,
		Parent = toastHolder,
	})
	UI.make("Frame", {
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = color,
		Corner = 10,
		Stroke = T.Outline,
		StrokeThickness = 2,
		Parent = toast,
	})
	local label = UI.text({
		Text = text,
		Position = UDim2.fromOffset(40, 6),
		Size = UDim2.new(1, -52, 1, -12),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.35),
		Parent = toast,
	})
	local scale = UI.make("UIScale", { Scale = 0.6, Parent = toast })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(3.5, function()
		TweenService:Create(toast, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, TweenInfo.new(0.35), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		local stroke = toast:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		end
		task.wait(0.4)
		toast:Destroy()
	end)
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		toasts[1]:Destroy()
	end
end

function Hud.Announce(text: string)
	local banner = UI.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -90),
		Size = UDim2.fromOffset(640, 64),
		Color = Color3.fromRGB(120, 70, 20),
		Corner = 16,
		Parent = gui,
	})
	UI.make("UIStroke", { Color = T.Gold, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = banner })
	UI.text({ Text = "★  " .. text .. "  ★", Size = UDim2.new(1, -24, 1, -16), Position = UDim2.fromOffset(12, 8), TextColor3 = T.Gold, Parent = banner })
	TweenService:Create(banner, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 0, 74) }):Play()
	task.delay(5, function()
		TweenService:Create(banner, TweenInfo.new(0.3), { Position = UDim2.new(0.5, 0, 0, -90) }):Play()
		task.wait(0.35)
		banner:Destroy()
	end)
end

function Hud.Flash(color: Color3, strength: number)
	local flash = UI.make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 1 - strength,
		ZIndex = 50,
		Parent = gui,
	})
	local tween = TweenService:Create(flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 })
	tween:Play()
	tween.Completed:Once(function()
		flash:Destroy()
	end)
end

function Hud.BigText(text: string, color: Color3, hold: number?)
	local label = UI.text({
		Text = text,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.34),
		Size = UDim2.fromOffset(700, 120),
		TextColor3 = color,
		TextStrokeTransparency = 0,
		ZIndex = 60,
		Parent = gui,
	})
	UI.make("UIStroke", { Color = T.Outline, Thickness = 4, Parent = label })
	local scale = UI.make("UIScale", { Scale = 0.2, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(hold or 1.4, function()
		TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		end
		task.wait(0.35)
		label:Destroy()
	end)
end

----------------------------------------------------------------------
-- Hotbar
----------------------------------------------------------------------
local function refreshSlots()
	local data = State.Data
	local sel = State.Selected
	for _, slot in slotButtons do
		local count = 0
		if data then
			if slot.Kind == "Flask" then
				count = data.Flasks[slot.Id] or 0
			elseif slot.Kind == "Draught" then
				count = data.Draughts[slot.Id] or 0
			end
		end
		local selected = sel.Kind == slot.Kind and (slot.Kind == "Feed" or sel.Id == slot.Id)
		if slot.Kind == "Feed" then
			local feedId = if sel.Kind == "Feed" then sel.Id else nil
			if feedId and data then
				count = data.Ingredients[feedId] or 0
				slot.Name.Text = Config.Ingredients[feedId].Name
			else
				slot.Name.Text = "Feed"
			end
			slot.Count.Visible = feedId ~= nil
			slot.Count.Text = "x" .. count
		else
			slot.Count.Text = "x" .. count
			slot.Count.BackgroundColor3 = if count > 0 then T.Gold else Color3.fromRGB(150, 140, 160)
		end
		local usable = count > 0 or slot.Kind == "Feed"
		if slot.Icon then
			for _, d in slot.Icon:GetDescendants() do
				if d:IsA("Frame") and d.BackgroundTransparency < 0.9 then
					d.BackgroundTransparency = if usable then 0 else 0.55
				end
			end
		end
		local stroke = slot.Button:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if selected then T.Gold else T.Outline
			stroke.Thickness = if selected then 4 else 3
		end
		local target = if selected then UDim2.fromOffset(0, -8) else UDim2.fromOffset(0, 0)
		TweenService:Create(slot.Button, TweenInfo.new(0.15), { Position = target }):Play()
	end
end

local function showFeedPicker()
	UI.clear(feedPicker)
	local data = State.Data
	local any = false
	UI.text({ Text = "Feed which ingredient?", Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 0, Parent = feedPicker })
	for i, id in Config.IngredientOrder do
		local count = data and data.Ingredients[id] or 0
		if count > 0 then
			any = true
			local def = Config.Ingredients[id]
			local b = UI.button({
				Text = "",
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, 42),
				Color = T.Slot,
			}, function()
				State.Select("Feed", id)
				feedPicker.Visible = false
			end)
			UI.orbIcon(b, def.Color, 28, { Position = UDim2.fromOffset(0, 2) })
			UI.text({ Text = def.Name, Position = UDim2.fromOffset(38, 4), Size = UDim2.new(1, -90, 1, -8), TextXAlignment = Enum.TextXAlignment.Left, Parent = b })
			UI.text({ Text = "x" .. count, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 4), Size = UDim2.new(0, 50, 1, -8), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.Gold, Parent = b })
			b.Parent = feedPicker
		end
	end
	if not any then
		UI.text({ Text = "No ingredients yet. Harvest glowing plants in the zones!", Size = UDim2.new(1, 0, 0, 44), TextWrapped = true, Font = T.Body, LayoutOrder = 1, Parent = feedPicker })
	end
	feedPicker.Visible = true
end

local function buildHotbar()
	local bar = UI.panel({
		Name = "Hotbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(0, 104),
		AutomaticSize = Enum.AutomaticSize.X,
		Color = T.PanelDark,
		BackgroundTransparency = 0.1,
		Corner = 18,
		Parent = gui,
	})
	UI.padding(bar, 10)
	UI.list(bar, 8, true)

	local entries = {}
	for _, f in Config.Flasks do
		table.insert(entries, { Kind = "Flask", Id = f.Id, Name = f.Name:gsub(" Flask", ""), Color = f.Color })
	end
	for _, d in Config.Draughts do
		table.insert(entries, { Kind = "Draught", Id = d.Id, Name = (d.Name:gsub(" Draught", "")), Color = d.Color })
	end
	table.insert(entries, { Kind = "Feed", Id = "", Name = "Feed", Color = T.Pink })

	for i, entry in entries do
		local holder = UI.make("Frame", { Size = UDim2.fromOffset(78, 84), BackgroundTransparency = 1, LayoutOrder = i, Parent = bar })
		local button = UI.button({
			Text = "",
			Size = UDim2.fromScale(1, 1),
			Color = T.Slot,
			Corner = 14,
		}, function()
			if entry.Kind == "Feed" then
				if feedPicker.Visible then
					feedPicker.Visible = false
				else
					showFeedPicker()
				end
			else
				feedPicker.Visible = false
				State.Select(entry.Kind, entry.Id)
			end
		end)
		button.Parent = holder
		local icon: Frame? = nil
		if entry.Kind == "Feed" then
			-- a heart drawn from two circles and a rotated square
			local heart = UI.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(42, 42), BackgroundTransparency = 1, Parent = button })
			UI.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58), Size = UDim2.fromScale(0.5, 0.5), Rotation = 45, BackgroundColor3 = T.Pink, Parent = heart })
			for _, x in { 0.32, 0.68 } do
				UI.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, 0.4), Size = UDim2.fromScale(0.42, 0.42), BackgroundColor3 = T.Pink, Corner = UDim.new(0.5, 0), Parent = heart })
			end
			icon = heart
		elseif entry.Kind == "Draught" then
			-- draughts are round splash potions, flasks have a neck
			icon = UI.orbIcon(button, entry.Color, 38, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6) })
		else
			icon = UI.flaskIcon(button, entry.Color, 46, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0) })
		end
		local name = UI.text({
			Text = entry.Name,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, 2),
			Size = UDim2.new(1, 6, 0, 20),
			Parent = button,
		})
		local count = UI.badge(button, "x0")
		if UserInputService.KeyboardEnabled then
			UI.text({
				Text = tostring(i),
				Position = UDim2.fromOffset(-4, -4),
				Size = UDim2.fromOffset(16, 16),
				TextColor3 = T.Muted,
				Parent = button,
			})
		end
		table.insert(slotButtons, { Kind = entry.Kind, Id = entry.Id, Button = button, Count = count, Name = name, Icon = icon, Color = entry.Color })
	end

	feedPicker = UI.panel({
		Name = "FeedPicker",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(0.5, 400, 1, -132),
		Size = UDim2.fromOffset(260, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = gui,
	})
	UI.padding(feedPicker, 10)
	UI.list(feedPicker, 6)

	hintLabel = UI.text({
		Text = "",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -128),
		Size = UDim2.fromOffset(600, 26),
		TextColor3 = T.Muted,
		Parent = gui,
	})

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local index = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if index >= 1 and index <= #entries then
			local entry = entries[index]
			if entry.Kind == "Feed" then
				showFeedPicker()
			else
				State.Select(entry.Kind, entry.Id)
			end
		end
	end)
end

local function refreshHint()
	local sel = State.Selected
	local verb = if sel.Kind == "Feed" then "feed it" elseif sel.Kind == "Draught" then "weaken it" else "throw"
	local how = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "Tap a guardian to " else "Click a guardian (or press F) to "
	hintLabel.Text = how .. verb
end

----------------------------------------------------------------------
-- Currency and menu buttons
----------------------------------------------------------------------
local function pill(parent: Instance, order: number, width: number): Frame
	local p = UI.panel({ Size = UDim2.fromOffset(width, 48), Color = T.PanelDark, Corner = 24, LayoutOrder = order, Parent = parent })
	return p
end

local function buildTopBar()
	local top = UI.make("Frame", {
		Position = UDim2.fromOffset(16, 16),
		Size = UDim2.fromOffset(0, 48),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local layout = UI.list(top, 10, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left

	local coins = pill(top, 1, 190)
	UI.coinIcon(coins, 36, { Position = UDim2.fromOffset(6, 6) })
	coinsLabel = UI.text({ Text = "0", Position = UDim2.fromOffset(50, 8), Size = UDim2.new(1, -62, 1, -16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Gold, Parent = coins })

	local vials = pill(top, 2, 130)
	UI.vialIcon(vials, 36, { Position = UDim2.fromOffset(8, 6) })
	vialsLabel = UI.text({ Text = "0", Position = UDim2.fromOffset(50, 8), Size = UDim2.new(1, -62, 1, -16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(190, 230, 255), Parent = vials })

	luckPill = pill(top, 3, 150)
	luckPill.Visible = false
	luckLabel = UI.text({ Text = "", Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 1, -16), TextColor3 = Color3.fromRGB(120, 255, 160), Parent = luckPill })

	local menus = UI.make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(84, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UI.list(menus, 10)
	local buttons = {
		{ "Journal", Color3.fromRGB(80, 160, 255), "J" },
		{ "Collection", Color3.fromRGB(255, 150, 60), "C" },
		{ "Help", Color3.fromRGB(120, 200, 110), "?" },
	}
	for i, info in buttons do
		local b = UI.button({ Text = "", LayoutOrder = i, Size = UDim2.fromOffset(84, 84), Color = info[2], Corner = 18 }, function()
			if Hud.OpenMenu then
				Hud.OpenMenu(info[1])
			end
		end)
		UI.text({ Text = info[3], AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(50, 46), Parent = b })
		UI.text({ Text = info[1], AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, 8, 0, 20), Parent = b })
		b.Parent = menus
	end
end

local shownCoins = 0
local function refreshTop()
	local data = State.Data
	if not data then
		return
	end
	-- count up/down smoothly
	local target = math.floor(data.Coins)
	local start = shownCoins
	task.spawn(function()
		for i = 1, 10 do
			shownCoins = math.floor(start + (target - start) * i / 10)
			coinsLabel.Text = UI.formatNumber(shownCoins)
			task.wait(0.03)
		end
	end)
	vialsLabel.Text = tostring(data.Vials)
end

function Hud.Init()
	gui = UI.screen()

	toastHolder = UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(460, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UI.list(toastHolder, 6)

	buildTopBar()
	buildHotbar()
	refreshHint()

	State.Changed:Connect(function()
		refreshTop()
		refreshSlots()
	end)
	State.SelectionChanged:Connect(function()
		refreshSlots()
		refreshHint()
	end)
	refreshSlots()

	task.spawn(function()
		while true do
			local data = State.Data
			local left = data and (data.LuckUntil or 0) - os.time() or 0
			luckPill.Visible = left > 0
			if left > 0 then
				luckLabel.Text = string.format("Luck %d:%02d", left // 60, left % 60)
			end
			task.wait(1)
		end
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source"><![CDATA[-- Pop-up windows: Brew (flasks, draughts, fusion), Shop, Journal,
-- Collection and Help. Only one is open at a time.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local T = UI.Theme

local Menus = {}

local gui: ScreenGui
local window: Frame
local windowScale: UIScale
local titleLabel: TextLabel
local header: Frame
local body: Frame
local current: string? = nil
local renderers: { [string]: (Frame) -> () } = {}

local TITLES = {
	Brew = { "Cauldron", Color3.fromRGB(90, 200, 120) },
	Shop = { "Shop", Color3.fromRGB(240, 110, 130) },
	Journal = { "Guardian Journal", Color3.fromRGB(80, 160, 255) },
	Collection = { "Your Guardians", Color3.fromRGB(255, 150, 60) },
	Help = { "How to Play", Color3.fromRGB(120, 200, 110) },
}

-- Brew window state
local brewMode = "Flask" -- "Flask" | "Draught" | "Fuse"
local slots: { string } = {}
local fuseUid: string? = nil
local releaseConfirm: string? = nil

local function slotCount(): number
	return if brewMode == "Draught" then Config.DraughtIngredientCount else Config.FlaskIngredientCount
end

local function usedCount(id: string): number
	local n = 0
	for _, s in slots do
		if s == id then
			n += 1
		end
	end
	return n
end

local function rerender()
	if current and renderers[current] then
		UI.clear(body)
		renderers[current](body)
	end
end

function Menus.Open(name: string)
	if current == name and window.Visible then
		Menus.Close()
		return
	end
	current = name
	local info = TITLES[name] or { name, T.Accent }
	titleLabel.Text = info[1]
	local top = header:FindFirstChildOfClass("UIGradient")
	local bottom = header:FindFirstChild("HeaderBottom")
	local bottomGradient = bottom and bottom:FindFirstChildOfClass("UIGradient")
	if top and bottomGradient then
		top.Color = ColorSequence.new(UI.lighten(info[2], 0.15), UI.darken(info[2], 0.15))
		bottomGradient.Color = ColorSequence.new(UI.darken(info[2], 0.1), UI.darken(info[2], 0.15))
	end
	releaseConfirm = nil
	if not window.Visible then
		window.Visible = true
		windowScale.Scale = 0.85
		TweenService:Create(windowScale, TweenInfo.new(0.22, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	rerender()
end

function Menus.Close()
	current = nil
	window.Visible = false
	slots = {}
	fuseUid = nil
end

----------------------------------------------------------------------
-- Layout helpers
----------------------------------------------------------------------
local function section(parent: Instance, text: string, order: number)
	return UI.text({
		Text = text,
		Size = UDim2.new(1, 0, 0, 24),
		TextColor3 = T.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function row(parent: Instance, height: number, order: number, align: Enum.HorizontalAlignment?): Frame
	local f = UI.make("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	local layout = UI.list(f, 10, true)
	layout.HorizontalAlignment = align or Enum.HorizontalAlignment.Left
	return f
end

local function grid(parent: Instance, cell: Vector2, order: number): Frame
	local f = UI.make("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	UI.make("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell.X, cell.Y),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = f,
	})
	return f
end

local function card(parent: Instance, height: number, order: number, accent: Color3?): Frame
	local c = UI.panel({
		Size = UDim2.new(1, 0, 0, height),
		Color = T.PanelLight,
		Corner = 12,
		LayoutOrder = order,
		Parent = parent,
	})
	if accent then
		-- UIPadding applies to every child, so pull the stripe back into the margin
		UI.make("Frame", {
			Size = UDim2.new(0, 6, 1, 0),
			Position = UDim2.fromOffset(-14, 0),
			BackgroundColor3 = accent,
			Corner = 3,
			Parent = c,
		})
	end
	UI.make("UIPadding", { PaddingLeft = UDim.new(0, if accent then 20 else 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = c })
	return c
end

local function stars(tier: number): string
	return string.rep("★", tier) .. string.rep("☆", 4 - tier)
end

----------------------------------------------------------------------
-- Brew
----------------------------------------------------------------------
local function autoFill()
	-- Best ingredients first, respecting what you own.
	local data = State.Data
	local order = table.clone(Config.IngredientOrder)
	table.sort(order, function(a, b)
		return Config.Ingredients[a].Tier > Config.Ingredients[b].Tier
	end)
	slots = {}
	for _, id in order do
		local owned = data.Ingredients[id] or 0
		while owned > 0 and #slots < slotCount() do
			table.insert(slots, id)
			owned -= 1
		end
	end
	rerender()
end

local function ingredientPicker(parent: Instance, order: number)
	local data = State.Data
	section(parent, "Your ingredients - tap to add", order)
	local g = grid(parent, Vector2.new(196, 58), order + 1)
	local any = false
	for i, id in Config.IngredientOrder do
		local def = Config.Ingredients[id]
		local owned = data.Ingredients[id] or 0
		local free = owned - usedCount(id)
		if owned > 0 then
			any = true
			local b = UI.button({ Text = "", LayoutOrder = i, Color = if free > 0 then T.Slot else T.PanelDark, Corner = 12 }, function()
				if free > 0 and #slots < slotCount() then
					table.insert(slots, id)
					rerender()
				end
			end)
			UI.orbIcon(b, def.Color, 38, { Position = UDim2.fromOffset(0, 3) })
			UI.text({ Text = def.Name, Position = UDim2.fromOffset(46, 0), Size = UDim2.new(1, -46, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, Parent = b })
			UI.text({ Text = stars(def.Tier), Position = UDim2.fromOffset(46, 24), Size = UDim2.new(1, -90, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Gold, Parent = b })
			UI.text({ Text = "x" .. free, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 24), Size = UDim2.fromOffset(44, 18), TextXAlignment = Enum.TextXAlignment.Right, Parent = b })
			b.Parent = g
		end
	end
	if not any then
		UI.text({ Text = "Nothing yet! Harvest glowing plants in the zones.", Size = UDim2.new(1, 0, 0, 30), LayoutOrder = order + 2, Parent = parent })
	end
end

local function slotRow(parent: Instance, order: number)
	local r = row(parent, 92, order, Enum.HorizontalAlignment.Center)
	for i = 1, slotCount() do
		local id = slots[i]
		local def = id and Config.Ingredients[id]
		local b = UI.button({ Text = "", LayoutOrder = i * 2, Size = UDim2.fromOffset(120, 88), Color = if def then T.Slot else T.PanelDark, Corner = 16 }, function()
			if slots[i] then
				table.remove(slots, i)
				rerender()
			end
		end)
		if def then
			UI.orbIcon(b, def.Color, 44, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0) })
			UI.text({ Text = def.Name, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, 0, 0, 22), Parent = b })
		else
			UI.text({ Text = "+", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(40, 40), TextColor3 = T.Muted, Parent = b })
		end
		b.Parent = r
		if i < slotCount() then
			UI.text({ Text = "+", LayoutOrder = i * 2 + 1, Size = UDim2.fromOffset(20, 30), TextColor3 = T.Muted, Parent = r })
		end
	end
end

local function renderBrew(parent: Frame)
	local data = State.Data
	if not data then
		return
	end

	local tabs = row(parent, 46, 1, Enum.HorizontalAlignment.Center)
	for i, mode in { "Flask", "Draught", "Fuse" } do
		local label = if mode == "Flask" then "Capture Flask" elseif mode == "Draught" then "Weakening Draught" else "Grow Guardian"
		UI.button({
			Text = label,
			LayoutOrder = i,
			Size = UDim2.fromOffset(200, 42),
			Color = if brewMode == mode then T.Accent else T.PanelLight,
		}, function()
			brewMode = mode
			slots = {}
			rerender()
		end).Parent = tabs
	end

	local quality = Config.QualityOf(slots, data.PotLevel)
	local potBonus = data.PotLevel - 1

	if brewMode == "Fuse" then
		section(parent, "1. Pick a guardian to grow", 2)
		local list = grid(parent, Vector2.new(200, 46), 3)
		if #data.Guardians == 0 then
			UI.text({ Text = "Catch a guardian first!", Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 3, Parent = parent })
		end
		for i, entry in data.Guardians do
			local maxed = (entry.Mutation or 0) >= #Config.Mutations
			UI.button({
				Text = Config.GuardianDisplayName(entry) .. (if maxed then " (max)" else ""),
				LayoutOrder = i,
				Color = if fuseUid == entry.Uid then T.Accent elseif maxed then T.PanelDark else T.Slot,
			}, function()
				if not maxed then
					fuseUid = entry.Uid
					rerender()
				end
			end).Parent = list
		end

		local selected = nil
		for _, entry in data.Guardians do
			if entry.Uid == fuseUid then
				selected = entry
			end
		end
		section(parent, "2. Add 3 ingredients - higher quality grows it bigger", 4)
		slotRow(parent, 5)
		local nextMutation = selected and Config.Mutations[(selected.Mutation or 0) + 1]
		local problem = if not selected
			then "Pick a guardian above"
			elseif not nextMutation then "Already at its biggest form"
			elseif #slots < Config.FlaskIngredientCount then string.format("Add %d more ingredient%s", Config.FlaskIngredientCount - #slots, if Config.FlaskIngredientCount - #slots == 1 then "" else "s")
			elseif quality < nextMutation.MinQuality then string.format("Quality %d - needs %d. Use better ingredients", quality, nextMutation.MinQuality)
			else nil
		local actions = row(parent, 56, 6, Enum.HorizontalAlignment.Center)
		UI.button({ Text = "Auto-fill", Size = UDim2.fromOffset(140, 50), Color = T.Blue }, autoFill).Parent = actions
		UI.button({
			Text = if problem then problem else string.format("Grow into %s!", nextMutation.Prefix),
			Size = UDim2.fromOffset(380, 50),
			Color = if problem then T.PanelLight else T.Pink,
		}, function()
			if not problem then
				Remotes.Fuse:FireServer(fuseUid, slots)
				slots = {}
			end
		end).Parent = actions
		ingredientPicker(parent, 8)
		return
	end

	local needed = slotCount()
	local isFlask = brewMode == "Flask"
	section(parent, string.format("Quality = ingredient stars added up%s", if potBonus > 0 then string.format(" (+%d from your cauldron)", potBonus) else ""), 2)
	slotRow(parent, 3)

	-- Result preview
	local result = if isFlask then Config.FlaskForQuality(quality) else Config.DraughtForQuality(quality)
	local list = if isFlask then Config.Flasks else Config.Draughts
	local nextTier = nil
	for _, entry in list do
		if entry.MinQuality > quality then
			nextTier = entry
			break
		end
	end
	local preview = card(parent, 76, 4, result.Color)
	UI.flaskIcon(preview, result.Color, 56, { Position = UDim2.fromOffset(0, 2) })
	UI.text({ Text = if #slots > 0 then result.Name else "Result", Position = UDim2.fromOffset(66, 2), Size = UDim2.new(1, -66, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.lighten(result.Color, 0.3), Parent = preview })
	local detail = if isFlask
		then string.format("Quality %d · catch power x%g", quality, result.Mult)
		else string.format("Quality %d · -%d resistance and slows it", quality, result.Power)
	if nextTier then
		detail ..= string.format("   (quality %d makes a %s)", nextTier.MinQuality, nextTier.Name)
	end
	UI.text({ Text = detail, Position = UDim2.fromOffset(66, 32), Size = UDim2.new(1, -66, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Muted, Font = T.Body, Parent = preview })

	local problem = if #slots < needed
		then string.format("Add %d more ingredient%s", needed - #slots, if needed - #slots == 1 then "" else "s")
		elseif data.Vials <= 0 then "No vials! Buy them at the Shop"
		else nil
	local actions = row(parent, 56, 5, Enum.HorizontalAlignment.Center)
	UI.button({ Text = "Auto-fill", Size = UDim2.fromOffset(140, 50), Color = T.Blue }, autoFill).Parent = actions
	UI.button({
		Text = problem or "Brew it!",
		Size = UDim2.fromOffset(300, 50),
		Color = if problem then T.PanelLight else T.Good,
	}, function()
		if not problem then
			Remotes.Brew:FireServer(brewMode, slots)
			slots = {}
		end
	end).Parent = actions
	local vialInfo = UI.text({ Text = string.format("1 vial  (%d left)", data.Vials), Size = UDim2.fromOffset(150, 30), TextColor3 = if data.Vials > 0 then T.Muted else T.Bad, Parent = actions })
	vialInfo.LayoutOrder = 3

	ingredientPicker(parent, 6)
end

----------------------------------------------------------------------
-- Shop
----------------------------------------------------------------------
local function renderShop(parent: Frame)
	local data = State.Data
	if not data then
		return
	end
	section(parent, "Flasks can't be bought - brew them at a cauldron!", 0)
	for i, item in Config.Shop do
		local owned = item.PotLevel and data.PotLevel >= item.PotLevel
		local locked = item.PotLevel and data.PotLevel < item.PotLevel - 1
		local c = card(parent, 76, i, if item.PotLevel then T.Accent else T.Blue)
		if item.PotLevel then
			UI.orbIcon(c, Color3.fromRGB(70, 70, 90), 52, { Position = UDim2.fromOffset(0, 4) })
		else
			UI.vialIcon(c, 56, { Position = UDim2.fromOffset(0, 2) })
		end
		UI.text({ Text = item.Name, Position = UDim2.fromOffset(66, 4), Size = UDim2.new(1, -240, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, Parent = c })
		UI.text({ Text = item.Description, Position = UDim2.fromOffset(66, 34), Size = UDim2.new(1, -240, 0, 20), TextColor3 = T.Muted, Font = T.Body, TextXAlignment = Enum.TextXAlignment.Left, Parent = c })
		local affordable = data.Coins >= item.Price
		local b = UI.button({
			Text = if owned then "Owned" elseif locked then "Locked" else UI.formatNumber(item.Price),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(160, 48),
			Color = if owned or locked or not affordable then T.PanelDark else T.Gold,
			Parent = c,
		}, function()
			if not owned and not locked then
				Remotes.Buy:FireServer(item.Id)
			end
		end)
		if not owned and not locked then
			UI.coinIcon(b, 26, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5) })
		end
	end

	if Config.Monetization.LuckBoostProductId ~= 0 then
		local c = card(parent, 76, 100, Color3.fromRGB(120, 255, 160))
		UI.text({ Text = string.format("Lucky Brew (%d min)", Config.Monetization.LuckBoostMinutes), Size = UDim2.new(1, -180, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, Parent = c })
		UI.text({ Text = string.format("All catch odds x%g while it lasts.", Config.Monetization.LuckBoostMultiplier), Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, -180, 0, 20), TextColor3 = T.Muted, Font = T.Body, TextXAlignment = Enum.TextXAlignment.Left, Parent = c })
		UI.button({ Text = "Robux", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(160, 48), Color = T.Good, Parent = c }, function()
			Remotes.BuyLuck:FireServer()
		end)
	end
end

----------------------------------------------------------------------
-- Journal
----------------------------------------------------------------------
local function renderJournal(parent: Frame)
	local data = State.Data
	if not data then
		return
	end
	local seenCount, caughtCount = 0, 0
	for _, id in Config.GuardianOrder do
		local j = data.Journal[id]
		if j then
			seenCount += 1
			if (j.Caught or 0) > 0 then
				caughtCount += 1
			end
		end
	end
	section(parent, string.format("Seen %d / %d     Caught %d / %d", seenCount, #Config.GuardianOrder, caughtCount, #Config.GuardianOrder), 0)

	for i, id in Config.GuardianOrder do
		local def = Config.Guardians[id]
		local j = data.Journal[id]
		local rarity = Config.Rarities[def.Rarity]
		local c = card(parent, if j then 118 else 64, i, if j then rarity.Color else T.Slot)
		if not j then
			UI.text({ Text = "???", Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Muted, Parent = c })
			UI.text({ Text = "Not seen yet. Look in " .. Config.Zones[def.Zone].Name .. ".", Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 20), TextColor3 = T.Muted, Font = T.Body, TextXAlignment = Enum.TextXAlignment.Left, Parent = c })
			continue
		end
		UI.orbIcon(c, def.Color, 48, { Position = UDim2.fromOffset(0, 0) })
		UI.text({ Text = def.Name, Position = UDim2.fromOffset(58, 0), Size = UDim2.new(0.5, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rarity.Color, Parent = c })
		UI.text({ Text = string.format("%s · %s", def.Rarity, def.Element), Position = UDim2.fromOffset(58, 28), Size = UDim2.new(0.5, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Muted, Parent = c })
		UI.text({
			Text = string.format("Caught %d", j.Caught or 0),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(140, 24),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = if (j.Caught or 0) > 0 then T.Good else T.Muted,
			Parent = c,
		})
		local favorite = if j.FavoriteKnown then "♥ Loves " .. Config.Ingredients[def.Favorite].Name else "♥ Favorite: ??? (feed it to find out)"
		local tried = {}
		for ingredientId in j.Tried or {} do
			if ingredientId ~= def.Favorite and Config.Ingredients[ingredientId] then
				table.insert(tried, Config.Ingredients[ingredientId].Name)
			end
		end
		if #tried > 0 and not j.FavoriteKnown then
			favorite ..= "   Not: " .. table.concat(tried, ", ")
		end
		UI.text({ Text = "Hint: " .. def.Hint, Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Font = T.Body, Parent = c })
		UI.text({ Text = favorite, Position = UDim2.fromOffset(0, 78), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Font = T.Body, TextColor3 = if j.FavoriteKnown then T.Pink else T.Muted, Parent = c })
	end
end

----------------------------------------------------------------------
-- Collection
----------------------------------------------------------------------
local function renderCollection(parent: Frame)
	local data = State.Data
	if not data then
		return
	end
	local total = 0
	for _, entry in data.Guardians do
		total += Config.GuardianIncome(entry)
	end
	section(parent, string.format("%d guardians · %s coins per second · your best %d live on your plot", #data.Guardians, UI.formatNumber(total), Config.MaxPlotDisplays), 0)

	local list = table.clone(data.Guardians)
	table.sort(list, function(a, b)
		return Config.GuardianIncome(a) > Config.GuardianIncome(b)
	end)
	for i, entry in list do
		local def = Config.Guardians[entry.Id]
		if not def then
			continue
		end
		local rarity = Config.Rarities[def.Rarity]
		local c = card(parent, 64, i, rarity.Color)
		UI.orbIcon(c, def.Color, 44, { Position = UDim2.fromOffset(0, 2) })
		UI.text({ Text = Config.GuardianDisplayName(entry), Position = UDim2.fromOffset(54, 0), Size = UDim2.new(1, -250, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rarity.Color, Parent = c })
		UI.text({ Text = string.format("%s · +%s coins/s", def.Rarity, UI.formatNumber(Config.GuardianIncome(entry))), Position = UDim2.fromOffset(54, 26), Size = UDim2.new(1, -250, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Muted, Parent = c })
		local value = math.floor(Config.GuardianIncome(entry) * Config.ReleaseValueSeconds)
		local confirming = releaseConfirm == entry.Uid
		UI.button({
			Text = if confirming then "Tap again to release" else "Release +" .. UI.formatNumber(value),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(190, 42),
			Color = if confirming then T.Bad else T.PanelDark,
			Parent = c,
		}, function()
			if confirming then
				releaseConfirm = nil
				Remotes.Release:FireServer(entry.Uid)
			else
				releaseConfirm = entry.Uid
				rerender()
			end
		end)
	end
	if #list == 0 then
		UI.text({ Text = "No guardians yet. Go catch one!", Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 1, Parent = parent })
	end
end

----------------------------------------------------------------------
-- Help
----------------------------------------------------------------------
local HELP = {
	{ "Harvest", "Pick glowing plants in the three zones to get ingredients.", Color3.fromRGB(120, 220, 120) },
	{ "Brew", "At a cauldron (your plot or the big one in the hub), mix 3 ingredients into a Capture Flask. More stars = stronger flask. Each brew uses an Empty Vial from the Shop.", Color3.fromRGB(150, 110, 255) },
	{ "Weaken", "Dodge the red attack zones, lure guardians into brambles, lava or ice spikes, or throw a Weakening Draught. Lower resistance = better odds.", Color3.fromRGB(255, 150, 70) },
	{ "Feed", "Every guardian loves one ingredient. Pick Feed and tap it. Guess right and your odds double!", T.Pink },
	{ "Catch", "Pick a flask and tap the guardian (or press F). Three shakes... then GOTCHA, or it bursts out furious.", T.Gold },
	{ "Earn & Grow", "Caught guardians earn coins on your plot - collect them at the chest. Feed them ingredients at a cauldron to grow giant versions.", Color3.fromRGB(80, 170, 255) },
}

local function renderHelp(parent: Frame)
	for i, step in HELP do
		local c = card(parent, 82, i, step[3])
		UI.text({ Text = string.format("%d. %s", i, step[1]), Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.lighten(step[3], 0.2), Parent = c })
		UI.text({
			Text = step[2],
			Position = UDim2.fromOffset(0, 28),
			Size = UDim2.new(1, 0, 0, 38),
			TextScaled = false,
			TextSize = 16,
			TextWrapped = true,
			Font = T.Body,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = c,
		})
	end
end

----------------------------------------------------------------------
function Menus.Init()
	gui = UI.screen()
	window = UI.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.fromOffset(720, 580),
		Corner = 20,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	windowScale = UI.make("UIScale", { Parent = window })

	header = UI.make("Frame", {
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Gradient = { T.Accent, UI.darken(T.Accent, 0.2) },
		Corner = 20,
		Parent = window,
	})
	-- square off the header's bottom corners
	UI.make("Frame", {
		Position = UDim2.new(0, 0, 1, -20),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Gradient = { UI.darken(T.Accent, 0.15), UI.darken(T.Accent, 0.2) },
		Name = "HeaderBottom",
		Parent = header,
	})
	titleLabel = UI.text({ Text = "", Position = UDim2.fromOffset(20, 10), Size = UDim2.new(1, -90, 0, 38), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2, Parent = header })
	UI.button({
		Text = "X",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(42, 42),
		Color = T.Bad,
		Corner = UDim.new(0.5, 0),
		ZIndex = 2,
		Parent = header,
	}, Menus.Close)

	local scroll = UI.make("ScrollingFrame", {
		Position = UDim2.fromOffset(14, 70),
		Size = UDim2.new(1, -28, 1, -84),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = T.Slot,
		Parent = window,
	})
	body = UI.make("Frame", {
		Size = UDim2.new(1, -14, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = scroll,
	})
	UI.make("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = body })
	local layout = UI.list(body, 10)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	layout.VerticalAlignment = Enum.VerticalAlignment.Top

	renderers.Brew = renderBrew
	renderers.Shop = renderShop
	renderers.Journal = renderJournal
	renderers.Collection = renderCollection
	renderers.Help = renderHelp

	State.Changed:Connect(function()
		-- Drop slot picks the player no longer owns.
		local data = State.Data
		if data then
			local counts = {}
			local kept = {}
			for _, id in slots do
				counts[id] = (counts[id] or 0) + 1
				if counts[id] <= (data.Ingredients[id] or 0) then
					table.insert(kept, id)
				end
			end
			slots = kept
		end
		rerender()
	end)
end

return Menus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Client-side copy of the player's data plus the selected action slot.

local State = {}

State.Data = nil :: any
-- { Kind = "Flask" | "Draught" | "Feed", Id = string }
State.Selected = { Kind = "Flask", Id = "Clay" }

local changed = Instance.new("BindableEvent")
local selectionChanged = Instance.new("BindableEvent")
State.Changed = changed.Event
State.SelectionChanged = selectionChanged.Event

function State.Set(data)
	State.Data = data
	changed:Fire(data)
end

function State.Select(kind: string, id: string)
	State.Selected = { Kind = kind, Id = id }
	selectionChanged:Fire(State.Selected)
end

-- How many of the selected item the player holds.
function State.SelectedCount(): number
	local data = State.Data
	if not data then
		return 0
	end
	local sel = State.Selected
	if sel.Kind == "Flask" then
		return data.Flasks[sel.Id] or 0
	elseif sel.Kind == "Draught" then
		return data.Draughts[sel.Id] or 0
	end
	return data.Ingredients[sel.Id] or 0
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Targeting</string>
            <string name="Source"><![CDATA[-- Tap/click a guardian to use the selected flask, draught or ingredient.
-- Also draws each guardian's overhead panel with live catch odds.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Hud = require(script.Parent.Hud)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local T = UI.Theme
local player = Players.LocalPlayer

local Targeting = {}

local guardianFolder: Folder
local highlight: Highlight
local panels: { [Model]: { Gui: BillboardGui, Bar: Frame, Status: TextLabel, Odds: TextLabel } } = {}

local function myRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function guardianFrom(instance: Instance?): Model?
	while instance and instance ~= guardianFolder do
		if instance.Parent == guardianFolder and instance:IsA("Model") then
			return instance
		end
		instance = instance.Parent
	end
	return nil
end

local function raycastScreen(position: Vector2): Model?
	local camera = workspace.CurrentCamera
	local ray = camera:ScreenPointToRay(position.X, position.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { guardianFolder }
	local result = workspace:Raycast(ray.Origin, ray.Direction * 400, params)
	if result then
		return guardianFrom(result.Instance)
	end
	-- Forgiving fallback for small targets on touch screens: nearest guardian
	-- whose screen position is close to the tap.
	local best, bestDist = nil, 70
	for _, model in guardianFolder:GetChildren() do
		if model:IsA("Model") then
			local screenPos, onScreen = camera:WorldToScreenPoint(model:GetPivot().Position)
			if onScreen then
				local d = (Vector2.new(screenPos.X, screenPos.Y) - position).Magnitude
				if d < bestDist then
					best, bestDist = model, d
				end
			end
		end
	end
	return best
end

local function nearestGuardian(): Model?
	local root = myRoot()
	if not root then
		return nil
	end
	local best, bestDist = nil, Config.Catch.ThrowRange
	for _, model in guardianFolder:GetChildren() do
		if model:IsA("Model") then
			local d = (model:GetPivot().Position - root.Position).Magnitude
			if d < bestDist then
				best, bestDist = model, d
			end
		end
	end
	return best
end

local lastAct = 0
local function act(model: Model)
	if os.clock() - lastAct < 0.3 then
		return
	end
	lastAct = os.clock()
	local root = myRoot()
	if not root then
		return
	end
	local sel = State.Selected
	if State.SelectedCount() <= 0 then
		if sel.Kind == "Feed" then
			Hud.Toast("Pick an ingredient with the Feed button first.", "error")
		else
			Hud.Toast("You're out of that. Brew more at your cauldron!", "error")
		end
		return
	end
	local distance = (model:GetPivot().Position - root.Position).Magnitude
	if sel.Kind == "Feed" then
		Remotes.Feed:FireServer(model, sel.Id)
	else
		if distance > Config.Catch.ThrowRange then
			Hud.Toast("Too far away to throw.", "error")
			return
		end
		Remotes.Throw:FireServer(sel.Kind, sel.Id, model)
	end
end

----------------------------------------------------------------------
-- Overhead panels
----------------------------------------------------------------------
local function chanceFor(model: Model, flaskMult: number): number
	local def = Config.Guardians[model:GetAttribute("GuardianId") :: string]
	local data = State.Data
	local luck = if data and (data.LuckUntil or 0) > os.time() then Config.Monetization.LuckBoostMultiplier else 1
	return CatchMath.Chance({
		BaseRate = def.BaseRate,
		FlaskMult = flaskMult,
		Resistance = (model:GetAttribute("Resistance") :: number?) or 100,
		FedFavorite = model:GetAttribute("FedFavorite") == true,
		Stunned = model:GetAttribute("Stunned") == true,
		Slowed = model:GetAttribute("Slowed") == true,
		Luck = luck,
	})
end

local function addPanel(instance: Instance)
	if not instance:IsA("Model") or panels[instance :: Model] then
		return
	end
	local model = instance :: Model
	local id = model:GetAttribute("GuardianId") :: string?
	local def = id and Config.Guardians[id]
	if not def then
		return
	end
	local rarity = Config.Rarities[def.Rarity]
	local gui = UI.make("BillboardGui", {
		Name = "GuardianPanel",
		Adornee = model.PrimaryPart,
		Size = UDim2.fromOffset(200, 84),
		StudsOffsetWorldSpace = Vector3.new(0, def.Size * 0.9 + 2, 0),
		MaxDistance = 120,
		AlwaysOnTop = true,
		Parent = player:WaitForChild("PlayerGui"),
	})
	gui.Size = UDim2.fromOffset(220, 96)
	UI.text({
		Text = def.Name,
		Size = UDim2.new(1, 0, 0, 26),
		TextColor3 = rarity.Color,
		TextStrokeTransparency = 0,
		Parent = gui,
	})
	local barBack = UI.make("Frame", {
		Position = UDim2.new(0.08, 0, 0, 30),
		Size = UDim2.new(0.84, 0, 0, 14),
		BackgroundColor3 = T.PanelDark,
		Corner = 7,
		Stroke = T.Outline,
		StrokeThickness = 2,
		Parent = gui,
	})
	local bar = UI.make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 110, 90),
		Corner = 7,
		Parent = barBack,
	})
	local status = UI.text({
		Text = "",
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 0, 18),
		TextColor3 = T.Text,
		Parent = gui,
	})
	local oddsPill = UI.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 68),
		Size = UDim2.fromOffset(180, 26),
		Color = T.PanelDark,
		Corner = 13,
		StrokeThickness = 2,
		Parent = gui,
	})
	local odds = UI.text({
		Text = "",
		Position = UDim2.fromOffset(8, 3),
		Size = UDim2.new(1, -16, 1, -6),
		TextColor3 = T.Gold,
		Parent = oddsPill,
	})
	panels[model] = { Gui = gui, Bar = bar, Status = status, Odds = odds }
end

local function removePanel(model: Instance)
	local panel = panels[model :: Model]
	if panel then
		panel.Gui:Destroy()
		panels[model :: Model] = nil
	end
end

local function updatePanels()
	local sel = State.Selected
	local data = State.Data
	for model, panel in panels do
		local resistance = (model:GetAttribute("Resistance") :: number?) or 100
		panel.Bar.Size = UDim2.fromScale(resistance / 100, 1)
		panel.Bar.BackgroundColor3 = Color3.fromRGB(110, 220, 120):Lerp(Color3.fromRGB(255, 90, 80), resistance / 100)

		local tags = {}
		if model:GetAttribute("FedFavorite") then
			table.insert(tags, "♥ Fed")
		end
		if model:GetAttribute("Stunned") then
			table.insert(tags, "✦ Stunned")
		elseif model:GetAttribute("Slowed") then
			table.insert(tags, "Slowed")
		end
		if model:GetAttribute("Enraged") then
			table.insert(tags, "FURIOUS")
		elseif model:GetAttribute("Calm") then
			table.insert(tags, "Calm")
		end
		panel.Status.Text = if #tags > 0 then table.concat(tags, "  ") else string.format("Resistance %d", resistance)

		local id = model:GetAttribute("GuardianId") :: string
		if sel.Kind == "Flask" then
			local flask = Config.GetFlask(sel.Id)
			if flask then
				panel.Odds.Text = string.format("%s: %d%%", flask.Name, math.floor(chanceFor(model, flask.Mult) * 100 + 0.5))
			end
		elseif sel.Kind == "Feed" then
			local j = data and data.Journal[id]
			local def = Config.Guardians[id]
			panel.Odds.Text = if j and j.FavoriteKnown
				then "Loves " .. Config.Ingredients[def.Favorite].Name
				else "Favorite: ???"
		else
			panel.Odds.Text = "Weaken it!"
		end
	end
end

----------------------------------------------------------------------
function Targeting.Init()
	guardianFolder = workspace:WaitForChild("Guardians") :: Folder

	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.8
	highlight.OutlineColor = T.Gold
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = workspace

	guardianFolder.ChildAdded:Connect(function(child)
		-- Attributes and PrimaryPart may replicate a frame later.
		task.wait()
		if child.Parent == guardianFolder then
			addPanel(child)
		end
	end)
	guardianFolder.ChildRemoved:Connect(removePanel)
	for _, child in guardianFolder:GetChildren() do
		addPanel(child)
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local model = raycastScreen(Vector2.new(input.Position.X, input.Position.Y))
			if model then
				act(model)
			end
		elseif input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonR2 then
			local model = nearestGuardian()
			if model then
				act(model)
			else
				Hud.Toast("No guardian in range.", "error")
			end
		end
	end)

	local accum = 0
	RunService.RenderStepped:Connect(function(dt)
		if UserInputService.MouseEnabled then
			local mouse = UserInputService:GetMouseLocation()
			local camera = workspace.CurrentCamera
			local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { guardianFolder }
			local result = workspace:Raycast(ray.Origin, ray.Direction * 400, params)
			highlight.Adornee = if result then guardianFrom(result.Instance) else nil
		end
		accum += dt
		if accum > 0.1 then
			accum = 0
			updatePanels()
		end
	end)
end

return Targeting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- UI kit: theme, chunky outlined buttons and panels, and small drawn icons
-- (flask, coin, vial, ingredient orb) so nothing depends on uploaded images.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = {}
UI.OnClick = nil :: (() -> ())? -- set by the HUD to play the click sound

UI.Theme = {
	Panel = Color3.fromRGB(46, 32, 72),
	PanelDark = Color3.fromRGB(30, 20, 48),
	PanelLight = Color3.fromRGB(70, 52, 104),
	Slot = Color3.fromRGB(88, 70, 124),
	Outline = Color3.fromRGB(16, 10, 26),
	Accent = Color3.fromRGB(150, 100, 255),
	Good = Color3.fromRGB(90, 210, 110),
	Bad = Color3.fromRGB(240, 80, 90),
	Gold = Color3.fromRGB(255, 200, 60),
	Blue = Color3.fromRGB(80, 170, 255),
	Pink = Color3.fromRGB(255, 120, 200),
	Text = Color3.fromRGB(255, 250, 240),
	Muted = Color3.fromRGB(190, 175, 220),
	Font = Enum.Font.FredokaOne,
	Body = Enum.Font.GothamBold,
}
local T = UI.Theme

local function lighten(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), a)
end
local function darken(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), a)
end
UI.lighten = lighten
UI.darken = darken

-- make("Frame", { Size = ..., Parent = ..., Corner = 8, Stroke = color }, { children })
function UI.make(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			elseif k == "Corner" then
				local c = Instance.new("UICorner")
				c.CornerRadius = if typeof(v) == "UDim" then v else UDim.new(0, v)
				c.Parent = inst
			elseif k == "Stroke" then
				local s = Instance.new("UIStroke")
				s.Color = v
				s.Thickness = props.StrokeThickness or 3
				s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				s.Parent = inst
			elseif k == "StrokeThickness" then
				continue
			elseif k == "Gradient" then
				local g = Instance.new("UIGradient")
				g.Color = ColorSequence.new(v[1], v[2])
				g.Rotation = 90
				g.Parent = inst
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- Bold text with a dark outline, the house style for every label.
function UI.text(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = T.Font,
		TextColor3 = T.Text,
		TextScaled = true,
		TextStrokeColor3 = T.Outline,
		TextStrokeTransparency = 0.35,
		Size = UDim2.new(1, 0, 0, 24),
	}
	for k, v in props do
		defaults[k] = v
	end
	return UI.make("TextLabel", defaults)
end

-- Chunky gradient button with a thick outline and a squash on press.
function UI.button(props: { [string]: any }, onClick: () -> ()): TextButton
	local color = props.Color or T.Accent
	props.Color = nil
	local defaults = {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Gradient = { lighten(color, 0.15), darken(color, 0.12) },
		Font = T.Font,
		TextColor3 = T.Text,
		TextScaled = true,
		TextStrokeColor3 = T.Outline,
		TextStrokeTransparency = 0.2,
		AutoButtonColor = false,
		Corner = 10,
		Stroke = T.Outline,
		Size = UDim2.fromOffset(120, 40),
	}
	for k, v in props do
		defaults[k] = v
	end
	local b = UI.make("TextButton", defaults)
	UI.make("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 5),
		PaddingBottom = UDim.new(0, 5),
		Parent = b,
	})
	local scale = UI.make("UIScale", { Parent = b })
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.93 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	b.MouseLeave:Connect(function()
		scale.Scale = 1
	end)
	b.Activated:Connect(function()
		if UI.OnClick then
			UI.OnClick()
		end
		onClick()
	end)
	return b
end

-- Panel with a soft vertical gradient and the dark outline.
function UI.panel(props: { [string]: any }): Frame
	local color = props.Color or T.Panel
	props.Color = nil
	local defaults = {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Gradient = { lighten(color, 0.08), darken(color, 0.15) },
		Corner = 14,
		Stroke = T.Outline,
	}
	for k, v in props do
		defaults[k] = v
	end
	return UI.make("Frame", defaults)
end

function UI.list(parent: Instance, padding: number, horizontal: boolean?): UIListLayout
	return UI.make("UIListLayout", {
		Padding = UDim.new(0, padding),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = parent,
	})
end

function UI.padding(parent: Instance, px: number)
	UI.make("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		Parent = parent,
	})
end

function UI.clear(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

----------------------------------------------------------------------
-- Drawn icons. Each fills a square `size` px box placed in `parent`.
----------------------------------------------------------------------
local function iconBox(parent: Instance, size: number, props: { [string]: any }?): Frame
	local box = UI.make("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Parent = parent })
	if props then
		for k, v in props do
			(box :: any)[k] = v
		end
	end
	return box
end

-- Round potion flask with neck, cork and a shine.
function UI.flaskIcon(parent: Instance, color: Color3, size: number, props: { [string]: any }?): Frame
	local box = iconBox(parent, size, props)
	UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.06),
		Size = UDim2.fromScale(0.26, 0.14),
		BackgroundColor3 = Color3.fromRGB(160, 110, 70),
		Corner = 3,
		Stroke = T.Outline,
		StrokeThickness = 2,
		Parent = box,
	})
	UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.18),
		Size = UDim2.fromScale(0.3, 0.22),
		BackgroundColor3 = lighten(color, 0.45),
		Stroke = T.Outline,
		StrokeThickness = 2,
		Parent = box,
	})
	local bulb = UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.98),
		Size = UDim2.fromScale(0.78, 0.62),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Gradient = { lighten(color, 0.3), darken(color, 0.15) },
		Corner = UDim.new(0.5, 0),
		Stroke = T.Outline,
		StrokeThickness = 2,
		Parent = box,
	})
	UI.make("Frame", {
		Position = UDim2.fromScale(0.2, 0.18),
		Size = UDim2.fromScale(0.2, 0.24),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.25,
		Corner = UDim.new(0.5, 0),
		Parent = bulb,
	})
	return box
end

function UI.coinIcon(parent: Instance, size: number, props: { [string]: any }?): Frame
	local box = iconBox(parent, size, props)
	local coin = UI.make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Gradient = { Color3.fromRGB(255, 225, 100), Color3.fromRGB(230, 150, 30) },
		Corner = UDim.new(0.5, 0),
		Stroke = T.Outline,
